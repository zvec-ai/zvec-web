"859":{"id":"/en/docs/zvec-grep/supported-content-11","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#structure-aware-code","content":"TypeScript and TSX","locale":"en"},"860":{"id":"/en/docs/zvec-grep/supported-content-12","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#structure-aware-code","content":"PHP, including `.phtml` templates","locale":"en"},"861":{"id":"/en/docs/zvec-grep/supported-content-13","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#structure-aware-code","content":"Python","locale":"en"},"862":{"id":"/en/docs/zvec-grep/supported-content-14","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#structure-aware-code","content":"Rust","locale":"en"},"863":{"id":"/en/docs/zvec-grep/supported-content-15","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#structure-aware-code","content":"Vue and Svelte component scripts also use structural extraction where possible.","locale":"en"},"864":{"id":"/en/docs/zvec-grep/supported-content-16","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#structure-aware-code","content":"In PHP files, template markup and top-level statements outside declarations stay searchable as plain-text chunks. PHP files indexed before structural support keep their plain-text chunks until you rebuild the index with `zg --index --rebuild`.","locale":"en"},"865":{"id":"/en/docs/zvec-grep/supported-content-17","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Content","locale":"en"},"866":{"id":"/en/docs/zvec-grep/supported-content-18","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Indexed representation","locale":"en"},"867":{"id":"/en/docs/zvec-grep/supported-content-19","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Markdown and MDX","locale":"en"},"868":{"id":"/en/docs/zvec-grep/supported-content-20","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Heading sections and breadcrumbs","locale":"en"},"869":{"id":"/en/docs/zvec-grep/supported-content-21","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"TXT, RST, HTML, XML","locale":"en"},"870":{"id":"/en/docs/zvec-grep/supported-content-22","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Plain-text chunks","locale":"en"},"871":{"id":"/en/docs/zvec-grep/supported-content-23","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"CSV, JSON, JSONC, TOML, YAML","locale":"en"},"872":{"id":"/en/docs/zvec-grep/supported-content-24","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Plain-text chunks","locale":"en"},"873":{"id":"/en/docs/zvec-grep/supported-content-25","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Other non-binary files","locale":"en"},"874":{"id":"/en/docs/zvec-grep/supported-content-26","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Plain-text fallback","locale":"en"},"875":{"id":"/en/docs/zvec-grep/supported-content-27","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#documents-and-structured-text","content":"Other recognized code such as Ruby, Swift, Kotlin, C#, Scala, shell, SQL, and CSS currently uses plain-text chunks when no structural grammar is available.","locale":"en"},"876":{"id":"/en/docs/zvec-grep/supported-content-28","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#images","content":"Images are not indexed. Explicitly including GIF, JPEG, PNG, or WebP files, or selecting a multimodal model, does not enable image indexing.","locale":"en"},"877":{"id":"/en/docs/zvec-grep/supported-content-29","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#content-currently-skipped","content":"PDF and Office files, archives, compiled artifacts, audio, video, database files, empty files, binaries detected by extension or content sampling, and files above the configured size limit are not indexed.","locale":"en"},"878":{"id":"/en/docs/zvec-grep/supported-content-30","page_id":"/en/docs/zvec-grep/supported-content","tags":[],"type":"text","url":"/en/docs/zvec-grep/supported-content#content-currently-skipped","content":"Use `zg --index --debug` to inspect skipped-file counts and samples. Scope discovery with `--glob`, file types, ignore files, depth, and maximum file size.","locale":"en"},"879":{"id":"/en/docs/zvec-grep/troubleshooting","page_id":"/en/docs/zvec-grep/troubleshooting","type":"page","content":"Troubleshooting","breadcrumbs":["Docs","Products","Zvec-Grep","Advanced"],"tags":[],"url":"/en/docs/zvec-grep/troubleshooting",