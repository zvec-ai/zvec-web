db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#how-it-works","content":"Performs an exact (brute-force) similarity search by comparing the query vector against every vector in the dataset.","locale":"en"},"1817":{"id":"/en/docs/db/concepts/vector-index/flat-index-6","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#when-to-use-a-flat-index","content":"✅ Small datasets","locale":"en"},"1818":{"id":"/en/docs/db/concepts/vector-index/flat-index-7","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#when-to-use-a-flat-index","content":"✅ Prototyping and experimentation","locale":"en"},"1819":{"id":"/en/docs/db/concepts/vector-index/flat-index-8","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#when-to-use-a-flat-index","content":"✅ Evaluation baselines","locale":"en"},"1820":{"id":"/en/docs/db/concepts/vector-index/flat-index-9","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#when-to-use-a-flat-index","content":"✅ Scenarios where 100% recall is non-negotiable","locale":"en"},"1821":{"id":"/en/docs/db/concepts/vector-index/flat-index-10","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#when-to-use-a-flat-index","content":"**Best Practice**: Start with Flat Index during development and testing — it's your reliability anchor. Once you validate your approach, consider approximate indexes (like HNSW) for production-scale performance. Use the Flat index when working with tiny datasets (e.g., under 300k vectors) where correctness outweighs speed.","locale":"en"},"1822":{"id":"/en/docs/db/concepts/vector-index/flat-index-11","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#advantages","content":"✨ **Perfect Recall Guarantee** — Finds true nearest neighbors","locale":"en"},"1823":{"id":"/en/docs/db/concepts/vector-index/flat-index-12","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#advantages","content":"✨ **Zero Configuration** — Simple setup with no tuning required","locale":"en"},"1824":{"id":"/en/docs/db/concepts/vector-index/flat-index-13","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#advantages","content":"✨ **Instant Indexing** — Build time is virtually immediate","locale":"en"},"1825":{"id":"/en/docs/db/concepts/vector-index/flat-index-14","page_id":"/en/docs/db/concepts/vector-index/flat-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/flat-index#limitations","content":"⚠️ Search latency grows linearly with dataset size — making it impractical for large-scale workloads.","locale":"en"},"1826":{"id":"/en/docs/db/concepts/vector-index/hnsw-index","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","type":"page","content":"HNSW Index","breadcrumbs":["Docs","Products","Zvec","Introduction","Concepts","Vector Index"],"tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-index","locale":"en"},"1827":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-0","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index","content":"The go-to graph-based index for low-latency approximate nearest neighbor search, delivering top-tier speed and recall at the cost of higher memory.","locale":"en"},"1828":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-1","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"How It Works","locale":"en"},"1829":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-2","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-index#when-to-use-an-hnsw-index","content":"When to Use an HNSW Index?","locale":"en"},"1830":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-3","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-index#advantages","content":"Advantages","locale":"en"},"1831":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-4","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-index#trade-offs","content":"Trade-offs","locale":"en"},"1832":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-5","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-index#key-parameters","content":"Key Parameters","locale":"en"},"1833":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-6","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"Index-Time Parameters","locale":"en"},"1834":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-7","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"Query-Time Parameters","locale":"en"},"1835":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-8","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"HNSW builds a **multi-layer graph structure** where each node represents a vector and edges connect nodes based on similarity.","locale":"en"},"1836":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-9","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"Layers form a hierarchy 🪜","locale":"en"},"1837":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-10","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"**Upper layers** are sparse with fewer nodes, acting as \"highways\" for fast long-range navigation.","locale":"en"},"1838":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-11","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"**Lower layers** are dense with more nodes, providing fine-grained local neighborhood connectivity.","locale":"en"},"1839":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-12","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"How search works (coarse → fine) 🔍","locale":"en"},"1840":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-13","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"Start from an **entry point** at the top layer.","locale":"en"},"1841":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-14","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"At the current layer, you greedily walk to neighbors that are closer to the query vector, until you can't get any closer.","locale":"en"},"1842":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-15","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"Then you **drop down one layer** at that position and repeat the same greedy search.","locale":"en"},"1843":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-16","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"On the **lowest layer**, this process is done more carefully (with a candidate list) to refine the result.","locale":"en"},"1844":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-17","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"**Why this is fast and accurate** ⚡ 🎯","locale":"en"},"1845":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-18","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"**Fast**: Upper layers let you jump quickly to the right region without visiting most points.","locale":"en"},"1846":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-19","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#how-it-works","content":"**Accurate**: The dense bottom layer lets you explore the local neighborhood thoroughly, so recall stays high.","locale":"en"},"1847":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-20","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#when-to-use-an-hnsw-index","content":"✅ Real-time, low-latency applications (e.g., conversational AI and live recommendations)","locale":"en"},"1848":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-21","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#when-to-use-an-hnsw-index","content":"✅ Production systems requiring consistent high recall with minimal latency","locale":"en"},"1849":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-22","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#when-to-use-an-hnsw-index","content":"**Best Practice**: HNSW is our **recommended default** for most production use cases. It strikes an excellent balance between speed, accuracy, and robustness.","locale":"en"},"1850":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-23","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#advantages","content":"✨ **Near-logarithmic query time** — Typically &#x2A;*O(log n)** for large datasets","locale":"en"},"1851":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-24","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#advantages","content":"✨ **Consistently high recall** across diverse data distributions","locale":"en"},"1852":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-25","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#advantages","content":"✨ **Faster indexing** than many alternatives (e.g., IVF-based methods)","locale":"en"},"1853":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-26","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#trade-offs","content":"⚠️ **Higher memory footprint** — Graph links require additional storage (scales with `m`)","locale":"en"},"1854":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-27","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#trade-offs","content":"⚠️ &#x2A;*Indexing complexity of O(n log n)** — Slower build time than Flat index (but often faster than IVF)","locale":"en"},"1855":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-28","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#key-parameters","content":"**Tuning Tip**: Start with defaults, then adjust `ef` first for recall/latency trade-offs. Only if needed, increase `ef_construction` or `m` for better accuracy — but expect slower indexing and higher memory use.","locale":"en"},"1856":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-29","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"Parameter","locale":"en"},"1857":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-30","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"Description","locale":"en"},"1858":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-31","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"Tuning Guidance","locale":"en"},"1859":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-32","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"`metric_type`","locale":"en"},"1860":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-33","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"**Similarity metric** used to compare vectors","locale":"en"},"1861":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-34","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"Choose based on how your embeddings were trained","locale":"en"},"1862":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-35","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"`m`","locale":"en"},"1863":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-36","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"**Max neighbors per node** — The maximum number of bidirectional links created for each node during graph construction","locale":"en"},"1864":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-37","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"• Higher `m` →  ✨ better recall and graph connectivity  ⚠️ more memory usage and higher latency for both indexing and search","locale":"en"},"1865":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-38","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"`ef_construction`","locale":"en"},"1866":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-39","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"**Index-time candidate pool size** — Determines how many neighboring candidates the algorithm considers when inserting a new vector into the graph","locale":"en"},"1867":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-40","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"• Higher `ef_construction` →  ✨ better graph quality and higher recall  ⚠️ longer index build time (*does not affect query speed*)","locale":"en"},"1868":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-41","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"`quantize_type`","locale":"en"},"1869":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-42","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"**Vector quantization method** to apply  Defaults to no quantization","locale":"en"},"1870":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-43","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#index-time-parameters","content":"See Quantization for more details","locale":"en"},"1871":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-44","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"Parameter","locale":"en"},"1872":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-45","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"Description","locale":"en"},"1873":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-46","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"Tuning Guidance","locale":"en"},"1874":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-47","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"`ef`","locale":"en"},"1875":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-48","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"**Query-time candidate pool size** — Determines how many potential neighbors are explored at each step during graph traversal at query time","locale":"en"},"1876":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-49","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"• Higher `ef` →  ✨ higher recall  ⚠️ higher query latency  💡 If you're missing results at `ef=300`, try bumping it up to `500` or even higher to cast a wider net.","locale":"en"},"1877":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-50","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"`radius`","locale":"en"},"1878":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-51","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"**Distance (similarity) threshold** for range-based filtering — only documents satisfying the threshold are returned","locale":"en"},"1879":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-52","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"Example:  • With inner product `MetricType.IP`, set `radius=0.6` to  keep only results with score > 0.6  ✅ Use when: You want to filter out low-quality matches  🚫 Skip when: You want all top-k results, regardless of quality","locale":"en"},"1880":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-53","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"`is_linear`","locale":"en"},"1881":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-54","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"Forces a **brute-force linear search** instead of using the index","locale":"en"},"1882":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-55","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"🐌 Very slow for large datasets!  ✅ Only use for: Debugging, tiny collections, or verifying index accuracy","locale":"en"},"1883":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-56","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"`is_using_refiner`","locale":"en"},"1884":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-57","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"**Enables exact score refinement** (recomputes exact similarity scores) for top candidates — helpful for **quantized** vectors to recover accuracy and boost recall quality","locale":"en"},"1885":{"id":"/en/docs/db/concepts/vector-index/hnsw-index-58","page_id":"/en/docs/db/concepts/vector-index/hnsw-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-index#query-time-parameters","content":"✅ Recommended: When you need higher accuracy for quantized vectors  ⚠️ Adds latency due to exact re-scoring","locale":"en"},"1886":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","type":"page","content":"HNSW-RaBitQ Index","breadcrumbs":["Docs","Products","Zvec","Introduction","Concepts","Vector Index"],"tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","locale":"en"},"1887":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-0","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","content":"HNSW with RaBitQ Quantization","locale":"en"},"1888":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-1","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#how-it-works","content":"How It Works","locale":"en"},"1889":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-2","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#when-to-use-hnsw-rabitq","content":"When to Use HNSW-RaBitQ?","locale":"en"},"1890":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-3","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#advantages","content":"Advantages","locale":"en"},"1891":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-4","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#trade-offs","content":"Trade-offs","locale":"en"},"1892":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-5","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#key-parameters","content":"Key Parameters","locale":"en"},"1893":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-6","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"Index-Time Parameters","locale":"en"},"1894":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-7","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"Query-Time Parameters","locale":"en"},"1895":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-8","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","content":"An advanced graph-based index that combines the HNSW graph structure with RaBitQ quantization algorithm — delivering **dramatically lower memory usage** while maintaining state-of-the-art search quality.","locale":"en"},"1896":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-9","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","content":"HNSW-RaBitQ supports Linux and macOS on x86\\_64 / ARM64, Windows x86\\_64, Android arm64-v8a, and iOS ARM64. On x86\\_64, the CPU must support AVX2/FMA or AVX-512 (F/BW/DQ); Zvec selects the available implementation at runtime. ARM64 uses NEON.","locale":"en"},"1897":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-10","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#how-it-works","content":"HNSW-RaBitQ combines two techniques to achieve high recall with minimal memory:","locale":"en"},"1898":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-11","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#how-it-works","content":"**HNSW graph for navigation** 🪜","locale":"en"},"1899":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-12","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#how-it-works","content":"Same multi-layer graph structure as the standard HNSW index — sparse upper layers for fast long-range jumps, dense lower layers for fine-grained local search.","locale":"en"},"1900":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-13","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#how-it-works","content":"**RaBitQ for distance estimation** 🔍","locale":"en"},"1901":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-14","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#how-it-works","content":"RaBitQ processes the data by applying a **random rotation** to the vectors before converting them into **binary codes** (1s and 0s). This approach allows the system to estimate distances using efficient bitwise operations, significantly **reducing both memory usage and the computational cost** compared to processing full-precision numbers.","locale":"en"},"1902":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-15","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#when-to-use-hnsw-rabitq","content":"✅ Production systems needing fast search and high recall with controlled memory budgets","locale":"en"},"1903":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-16","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#when-to-use-hnsw-rabitq","content":"✅ Massive high-dimensional datasets — billion-scale vectors with 1536+ dimensions that would consume terabytes of RAM in FP32 format","locale":"en"},"1904":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-17","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#when-to-use-hnsw-rabitq","content":"**Best Practice**: Use HNSW-RaBitQ when you want HNSW-quality search without the memory overhead.","locale":"en"},"1905":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-18","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#when-to-use-hnsw-rabitq","content":"The `total_bits` parameter controls the accuracy–memory trade-off. According to the paper, on specific datasets, **7 bits** achieves \\~99% recall, **5 bits** \\~95%, and **4 bits** \\~90%. Going as low as **1 bit** maximizes compression at the cost of lower recall.","locale":"en"},"1906":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-19","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#advantages","content":"✨ **Dramatically lower memory** — Quantized vectors are up to 32x smaller than FP32, reducing active index size","locale":"en"},"1907":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-20","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#advantages","content":"✨ **Fast Distance Estimation** — RaBitQ supports to estimate the similarity metrics with high efficiency based on bitwise operations","locale":"en"},"1908":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-21","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#advantages","content":"✨ **Promising Recall Without Re-ranking** — Graph construction uses original vectors, preserving graph quality and RaBitQ provides an asymptotically optimal error bound for reliable ordering and reranking.","locale":"en"},"1909":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-22","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#trade-offs","content":"⚠️ **Training overhead** — Requires a KMeans training step before index construction, adding to build time","locale":"en"},"1910":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-23","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#trade-offs","content":"⚠️ **Dimension constraints** — Only supports vectors between 64 and 4095 dimensions","locale":"en"},"1911":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-24","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#key-parameters","content":"**Tuning Tip**:\nStart with the defaults (`total_bits=7`, `num_clusters=16`). Adjust `ef` first for recall/latency trade-offs at query time. Only reduce `total_bits` if you need to cut memory further and can tolerate slightly lower recall.","locale":"en"},"1912":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-25","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"Parameter","locale":"en"},"1913":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-26","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"Description","locale":"en"},"1914":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-27","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"Tuning Guidance","locale":"en"},"1915":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-28","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"`metric_type`","locale":"en"},"1916":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-29","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"Similarity metric used to compare vectors","locale":"en"},"1917":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-30","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"Choose based on how your embeddings were trained","locale":"en"},"1918":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-31","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"`m`","locale":"en"},"1919":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-32","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"**Max neighbors per node** — The maximum number of bidirectional links created for each node during graph construction","locale":"en"},"1920":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-33","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"• Higher `m` →  ✨ better recall and graph connectivity  ⚠️ more memory usage and higher latency for both indexing and search","locale":"en"},"1921":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-34","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"`ef_construction`","locale":"en"},"1922":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-35","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"**Index-time candidate pool size** — Determines how many neighboring candidates the algorithm considers when inserting a new vector into the graph","locale":"en"},"1923":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-36","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"• Higher `ef_construction` →  ✨ better graph quality and higher recall  ⚠️ longer index build time (*does not affect query speed*)","locale":"en"},"1924":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-37","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"`total_bits`","locale":"en"},"1925":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-38","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"**RaBitQ quantization bits per dimension** — Controls the precision of the binary encoding","locale":"en"},"1926":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-39","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"Controls the accuracy–memory trade-off.  Lower values save more memory but reduce accuracy","locale":"en"},"1927":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-40","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"`num_clusters`","locale":"en"},"1928":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-41","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"**Number of KMeans clusters** — Used during the RaBitQ training phase to partition the vector space","locale":"en"},"1929":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-42","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"• More clusters can capture finer distribution patterns  • Higher values increase recall slightly","locale":"en"},"1930":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-43","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"`sample_count`","locale":"en"},"1931":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-44","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"**Training sample count** — Number of vectors sampled for KMeans training (`0` = use all vectors)","locale":"en"},"1932":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-45","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#index-time-parameters","content":"Default is `0`. Set a smaller value (e.g. 5,000,000) to speed up training and reduce memory usage on very large datasets","locale":"en"},"1933":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-46","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"Parameter","locale":"en"},"1934":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-47","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"Description","locale":"en"},"1935":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-48","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"Tuning Guidance","locale":"en"},"1936":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-49","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"`ef`","locale":"en"},"1937":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-50","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"**Query-time candidate pool size** — Determines how many potential neighbors are explored at each step during graph traversal at query time","locale":"en"},"1938":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-51","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"• Higher `ef` →  ✨ higher recall  ⚠️ higher query latency","locale":"en"},"1939":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-52","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"`radius`","locale":"en"},"1940":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-53","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"**Distance (similarity) threshold** for range-based filtering — only documents satisfying the threshold are returned","locale":"en"},"1941":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-54","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"Example:  • With inner product `MetricType.IP`, set `radius=0.6` to keep only results with score > 0.6  ✅ Use when: You want to filter out low-quality matches  🚫 Skip when: You want all top-k results, regardless of quality","locale":"en"},"1942":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-55","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"`is_linear`","locale":"en"},"1943":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-56","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"Forces a **brute-force linear search** instead of using the index","locale":"en"},"1944":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-57","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"🐌 Very slow for large datasets!  ✅ Only use for: Debugging, tiny collections, or verifying index accuracy","locale":"en"},"1945":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-58","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"`is_using_refiner`","locale":"en"},"1946":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-59","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"**Enables exact score refinement** — recomputes exact FP32 distances for top candidates after quantized search","locale":"en"},"1947":{"id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index-60","page_id":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/hnsw-rabitq-index#query-time-parameters","content":"✅ Turn on: When you need maximum precision  ⚠️ Adds latency due to full-precision re-scoring","locale":"en"},"1948":{"id":"/en/docs/db/concepts/vector-index","page_id":"/en/docs/db/concepts/vector-index","type":"page","content":"Vector Index","breadcrumbs":["Docs","Products","Zvec","Introduction","Concepts","Vector Index"],"tags":[],"url":"/en/docs/db/concepts/vector-index","locale":"en"},"1949":{"id":"/en/docs/db/concepts/vector-index-0","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index","content":"Specialized data structures that accelerate similarity search — trading a small amount of recall for massive gains in speed and scalability.","locale":"en"},"1950":{"id":"/en/docs/db/concepts/vector-index-1","page_id":"/en/docs/db/concepts/vector-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index#approximate-vs-exact-search","content":"Approximate vs. Exact Search","locale":"en"},"1951":{"id":"/en/docs/db/concepts/vector-index-2","page_id":"/en/docs/db/concepts/vector-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index#recall-measuring-approximation-quality","content":"Recall: Measuring Approximation Quality","locale":"en"},"1952":{"id":"/en/docs/db/concepts/vector-index-3","page_id":"/en/docs/db/concepts/vector-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"Vector Index Types","locale":"en"},"1953":{"id":"/en/docs/db/concepts/vector-index-4","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index","content":"A vector index is a specialized data structure that accelerates similarity search over large collections of vector embeddings.","locale":"en"},"1954":{"id":"/en/docs/db/concepts/vector-index-5","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index","content":"Without an index, finding the most similar items to a query requires comparing it against **every single vector** in the database — a process known as **brute-force** or **flat search**.","locale":"en"},"1955":{"id":"/en/docs/db/concepts/vector-index-6","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index","content":"Brute-force search is:","locale":"en"},"1956":{"id":"/en/docs/db/concepts/vector-index-7","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index","content":"✅ **Accurate**: Returns the exact most similar results — no approximation.","locale":"en"},"1957":{"id":"/en/docs/db/concepts/vector-index-8","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index","content":"⚠️ **Painfully slow at scale**: With millions or billions of vectors, queries can take seconds or minutes, making them impractical for real-time applications.","locale":"en"},"1958":{"id":"/en/docs/db/concepts/vector-index-9","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#approximate-vs-exact-search","content":"Most vector indexes use &#x2A;**Approximate Nearest Neighbor (ANN)*** algorithms.","locale":"en"},"1959":{"id":"/en/docs/db/concepts/vector-index-10","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#approximate-vs-exact-search","content":"Instead of finding the exact closest matches, ANN finds *very close approximations* — often indistinguishable in quality for practical purposes — while delivering massive gains in speed and efficiency.","locale":"en"},"1960":{"id":"/en/docs/db/concepts/vector-index-11","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#approximate-vs-exact-search","content":"For real-world uses, such as semantic search or recommendations, this small accuracy trade-off delivers huge gains in speed and scalability. In short: &#x2A;**good enough to be correct, but lightning fast*** ✨.","locale":"en"},"1961":{"id":"/en/docs/db/concepts/vector-index-12","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#recall-measuring-approximation-quality","content":"**Recall** is the standard metric for evaluating how well an ANN algorithm preserves result quality.","locale":"en"},"1962":{"id":"/en/docs/db/concepts/vector-index-13","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#recall-measuring-approximation-quality","content":"It quantifies the fraction of **true nearest neighbors** — identified by an exact (brute-force) search — that appear in the top‑k results returned by the approximate method:","locale":"en"},"1963":{"id":"/en/docs/db/concepts/vector-index-14","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#recall-measuring-approximation-quality","content":"Example:","locale":"en"},"1964":{"id":"/en/docs/db/concepts/vector-index-15","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#recall-measuring-approximation-quality","content":"If you request the top 10 results and 9 of them match the true top 10 from a brute-force search, your `recall@10` is 90%.","locale":"en"},"1965":{"id":"/en/docs/db/concepts/vector-index-16","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#recall-measuring-approximation-quality","content":"High recall (e.g., ≥ 96%) typically means the approximation is practically indistinguishable from exact search for most applications.","locale":"en"},"1966":{"id":"/en/docs/db/concepts/vector-index-17","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#recall-measuring-approximation-quality","content":"By leveraging different index types (e.g., HNSW) and tuning parameters (e.g., `ef_search&#x60;) you can strike a balance between &#x2A;**recall, query speed, and resource usage*** — so you can optimize for your specific accuracy and performance requirements.","locale":"en"},"1967":{"id":"/en/docs/db/concepts/vector-index-18","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"Zvec supports the following vector index types, each suited to different use cases, dataset sizes, and performance requirements:","locale":"en"},"1968":{"id":"/en/docs/db/concepts/vector-index-19","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"Flat (Brute-Force) index","locale":"en"},"1969":{"id":"/en/docs/db/concepts/vector-index-20","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"HNSW (Hierarchical Navigable Small World)","locale":"en"},"1970":{"id":"/en/docs/db/concepts/vector-index-21","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"HNSW-RaBitQ (HNSW with RaBitQ Quantization)","locale":"en"},"1971":{"id":"/en/docs/db/concepts/vector-index-22","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"DiskANN (Disk-based Approximate Nearest Neighbor)","locale":"en"},"1972":{"id":"/en/docs/db/concepts/vector-index-23","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"IVF (Inverted File Index)","locale":"en"},"1973":{"id":"/en/docs/db/concepts/vector-index-24","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"IVF-RaBitQ (IVF with RaBitQ Quantization)","locale":"en"},"1974":{"id":"/en/docs/db/concepts/vector-index-25","page_id":"/en/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index#vector-index-types","content":"Choose an index type based on your scale, latency requirements, and accuracy tolerance. Always use the same distance metric that your embedding model was trained for.","locale":"en"},"1975":{"id":"/en/docs/db/concepts/vector-index/ivf-index","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"page","content":"IVF Index","breadcrumbs":["Docs","Products","Zvec","Introduction","Concepts","Vector Index"],"tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index","locale":"en"},"1976":{"id":"/en/docs/db/concepts/vector-index/ivf-index-0","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index","content":"A scalable, partition-based, memory-efficient index designed for massive, naturally clustered datasets — at the expense of slower indexing and tuning.","locale":"en"},"1977":{"id":"/en/docs/db/concepts/vector-index/ivf-index-1","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#how-it-works","content":"How It Works","locale":"en"},"1978":{"id":"/en/docs/db/concepts/vector-index/ivf-index-2","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#indexing-phase-️","content":"Indexing Phase ⚙️","locale":"en"},"1979":{"id":"/en/docs/db/concepts/vector-index/ivf-index-3","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#query-phase-","content":"Query Phase 🔍","locale":"en"},"1980":{"id":"/en/docs/db/concepts/vector-index/ivf-index-4","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#when-to-use-an-ivf-index","content":"When to Use an IVF Index","locale":"en"},"1981":{"id":"/en/docs/db/concepts/vector-index/ivf-index-5","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#advantages","content":"Advantages","locale":"en"},"1982":{"id":"/en/docs/db/concepts/vector-index/ivf-index-6","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#trade-offs","content":"Trade-offs","locale":"en"},"1983":{"id":"/en/docs/db/concepts/vector-index/ivf-index-7","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#key-parameters","content":"Key Parameters","locale":"en"},"1984":{"id":"/en/docs/db/concepts/vector-index/ivf-index-8","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"Index-Time Parameters","locale":"en"},"1985":{"id":"/en/docs/db/concepts/vector-index/ivf-index-9","page_id":"/en/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"Query-Time Parameters","locale":"en"},"1986":{"id":"/en/docs/db/concepts/vector-index/ivf-index-10","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#how-it-works","content":"IVF operates by **partitioning the entire vector space into clusters**. The number of clusters is controlled by the parameter `n_list` (short for \"number of lists\").","locale":"en"},"1987":{"id":"/en/docs/db/concepts/vector-index/ivf-index-11","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#indexing-phase-️","content":"**Clustering**: The algorithm first applies a clustering algorithm, creating `n_list` clusters. Each cluster is represented by its centroid — a central point that best represents all vectors assigned to that cluster.","locale":"en"},"1988":{"id":"/en/docs/db/concepts/vector-index/ivf-index-12","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#indexing-phase-️","content":"**Assignment**: Each vector in the dataset is assigned to the **cluster whose centroid is closest** to it. The vector is then stored in an inverted list (also called a \"bucket\") associated with that centroid. The index essentially becomes a mapping from centroids to their associated vectors.","locale":"en"},"1989":{"id":"/en/docs/db/concepts/vector-index/ivf-index-13","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-phase-","content":"**Centroid Selection**: When a query vector arrives, the system first computes distances between the query and all `n_list` centroids to identify the `n_probe` nearest centroids (`n_probe` is a parameter that controls how many centroids to consider).","locale":"en"},"1990":{"id":"/en/docs/db/concepts/vector-index/ivf-index-14","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-phase-","content":"**Local Search**: Instead of scanning the entire dataset of `N` vectors, the search is **restricted to only the vectors stored in the `n_probe` selected buckets**. A brute-force (or refined) search is then performed within those buckets to find the nearest neighbors.","locale":"en"},"1991":{"id":"/en/docs/db/concepts/vector-index/ivf-index-15","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#when-to-use-an-ivf-index","content":"✅ Your vector dataset exhibits natural clustering or locality structure","locale":"en"},"1992":{"id":"/en/docs/db/concepts/vector-index/ivf-index-16","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#when-to-use-an-ivf-index","content":"✅ You're working with very large datasets and memory efficiency is critical","locale":"en"},"1993":{"id":"/en/docs/db/concepts/vector-index/ivf-index-17","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#when-to-use-an-ivf-index","content":"✅ You need to tune parameters to achieve optimal performance","locale":"en"},"1994":{"id":"/en/docs/db/concepts/vector-index/ivf-index-18","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#when-to-use-an-ivf-index","content":"**Best Practice**:","locale":"en"},"1995":{"id":"/en/docs/db/concepts/vector-index/ivf-index-19","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#when-to-use-an-ivf-index","content":"IVF works best on datasets with inherent clustering structure.","locale":"en"},"1996":{"id":"/en/docs/db/concepts/vector-index/ivf-index-20","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#when-to-use-an-ivf-index","content":"For even greater memory efficiency and scalability, combine it with Product Quantization (PQ).","locale":"en"},"1997":{"id":"/en/docs/db/concepts/vector-index/ivf-index-21","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#when-to-use-an-ivf-index","content":"The performance of IVF is highly sensitive to parameters like `n_list`. As such, IVF is best suited for practitioners who can systematically experiment with, validate, and optimize these settings for their specific data distribution and latency-recall requirements.","locale":"en"},"1998":{"id":"/en/docs/db/concepts/vector-index/ivf-index-22","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#advantages","content":"✨ **Compatibility** — Often used as a base layer in composite indexes (e.g., IVF-PQ) for further optimization","locale":"en"},"1999":{"id":"/en/docs/db/concepts/vector-index/ivf-index-23","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#advantages","content":"✨ **Scalability** — Query time scales approximately as &#x2A;*O(N / `n_list` × `n_probe`)**, making it highly efficient for large `N` when `n_list` is large and `n_probe` is small","locale":"en"},"2000":{"id":"/en/docs/db/concepts/vector-index/ivf-index-24","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#advantages","content":"✨ **Memory Efficiency** — Stores vectors in compact inverted lists with minimal overhead from centroids and list pointers, typically uses significantly less memory than graph-based methods like HNSW","locale":"en"},"2001":{"id":"/en/docs/db/concepts/vector-index/ivf-index-25","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#trade-offs","content":"⚠️ **Indexing Overhead** — Building the index requires clustering, which can be computationally intensive and slower to build than indexes like HNSW","locale":"en"},"2002":{"id":"/en/docs/db/concepts/vector-index/ivf-index-26","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#trade-offs","content":"⚠️ **Parameter Sensitivity** — Accuracy and latency are highly dependent on the choice of `n_list` and `n_probe`","locale":"en"},"2003":{"id":"/en/docs/db/concepts/vector-index/ivf-index-27","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"Parameter","locale":"en"},"2004":{"id":"/en/docs/db/concepts/vector-index/ivf-index-28","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"Description","locale":"en"},"2005":{"id":"/en/docs/db/concepts/vector-index/ivf-index-29","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"Tuning Guidance","locale":"en"},"2006":{"id":"/en/docs/db/concepts/vector-index/ivf-index-30","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"`metric_type`","locale":"en"},"2007":{"id":"/en/docs/db/concepts/vector-index/ivf-index-31","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"**Similarity metric** used to compare vectors","locale":"en"},"2008":{"id":"/en/docs/db/concepts/vector-index/ivf-index-32","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"Choose based on how your embeddings were trained","locale":"en"},"2009":{"id":"/en/docs/db/concepts/vector-index/ivf-index-33","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"`n_list`","locale":"en"},"2010":{"id":"/en/docs/db/concepts/vector-index/ivf-index-34","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"**Number of clusters** (inverted lists) — the vector space is partitioned into this many clusters during indexing","locale":"en"},"2011":{"id":"/en/docs/db/concepts/vector-index/ivf-index-35","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"• Start with `n_list` ≈ $\\sqrt{N}$, where `N` is the number of vectors  • Larger `n_list` → ✨ finer partitioning, smaller buckets, faster search — but ⚠️ higher indexing cost and more centroids to manage  • Smaller `n_list` → ✨ faster index construction — but ⚠️ larger buckets and slower search","locale":"en"},"2012":{"id":"/en/docs/db/concepts/vector-index/ivf-index-36","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"`n_iters`","locale":"en"},"2013":{"id":"/en/docs/db/concepts/vector-index/ivf-index-37","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"**Centroid refinement iterations** — number of passes to optimize cluster centroids during indexing","locale":"en"},"2014":{"id":"/en/docs/db/concepts/vector-index/ivf-index-38","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"• Higher `n_iters` →  ✨ better clustering quality  ⚠️ longer index build time","locale":"en"},"2015":{"id":"/en/docs/db/concepts/vector-index/ivf-index-39","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"`quantize_type`","locale":"en"},"2016":{"id":"/en/docs/db/concepts/vector-index/ivf-index-40","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"**Vector quantization method** to apply  Defaults to no quantization","locale":"en"},"2017":{"id":"/en/docs/db/concepts/vector-index/ivf-index-41","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#index-time-parameters","content":"See Quantization for more details","locale":"en"},"2018":{"id":"/en/docs/db/concepts/vector-index/ivf-index-42","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"Parameter","locale":"en"},"2019":{"id":"/en/docs/db/concepts/vector-index/ivf-index-43","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"Description","locale":"en"},"2020":{"id":"/en/docs/db/concepts/vector-index/ivf-index-44","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"Tuning Guidance","locale":"en"},"2021":{"id":"/en/docs/db/concepts/vector-index/ivf-index-45","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"`n_probe`","locale":"en"},"2022":{"id":"/en/docs/db/concepts/vector-index/ivf-index-46","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"**Number of clusters to search at query time** — the system retrieves candidates only from these nearest clusters.","locale":"en"},"2023":{"id":"/en/docs/db/concepts/vector-index/ivf-index-47","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"• Higher `n_probe` →  ✨ higher recall  ⚠️ slower queries","locale":"en"},"2024":{"id":"/en/docs/db/concepts/vector-index/ivf-index-48","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"`radius`","locale":"en"},"2025":{"id":"/en/docs/db/concepts/vector-index/ivf-index-49","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"**Distance (similarity) threshold** for range-based filtering — only documents satisfying the threshold are returned","locale":"en"},"2026":{"id":"/en/docs/db/concepts/vector-index/ivf-index-50","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"Example:  • With inner product `MetricType.IP`, set `radius=0.6` to  keep only results with score > 0.6  ✅ Use when: You want to filter out low-quality matches  🚫 Skip when: You want all top-k results, regardless of quality","locale":"en"},"2027":{"id":"/en/docs/db/concepts/vector-index/ivf-index-51","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"`is_linear`","locale":"en"},"2028":{"id":"/en/docs/db/concepts/vector-index/ivf-index-52","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"Forces a **brute-force linear search** instead of using the index","locale":"en"},"2029":{"id":"/en/docs/db/concepts/vector-index/ivf-index-53","page_id":"/en/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-index#query-time-parameters","content":"🐌 Very slow for large datasets!  ✅ Only use for: Debugging, tiny collections, or verifying index accuracy","locale":"en"},"2030":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"page","content":"IVF-RaBitQ Index","breadcrumbs":["Docs","Products","Zvec","Introduction","Concepts","Vector Index"],"tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","locale":"en"},"2031":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-0","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","content":"Combines IVF clustering with RaBitQ quantization to reduce both the search scope and vector storage, making it suitable for large-scale approximate vector search under constrained memory budgets.","locale":"en"},"2032":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-1","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#how-it-works","content":"How It Works","locale":"en"},"2033":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-2","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-construction-️","content":"Index Construction ⚙️","locale":"en"},"2034":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-3","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-","content":"Query 🔍","locale":"en"},"2035":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-4","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#when-to-use-ivf-rabitq","content":"When to Use IVF-RaBitQ","locale":"en"},"2036":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-5","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#advantages","content":"Advantages","locale":"en"},"2037":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-6","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#trade-offs","content":"Trade-offs","locale":"en"},"2038":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-7","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#key-parameters","content":"Key Parameters","locale":"en"},"2039":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-8","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Index-Time Parameters","locale":"en"},"2040":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-9","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Query-Time Parameters","locale":"en"},"2041":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-10","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","content":"IVF-RaBitQ combines the cluster partitioning of IVF with RaBitQ quantization. IVF first narrows the candidate search space, while RaBitQ estimates candidate distances from compact binary codes, reducing both query computation and index memory usage.","locale":"en"},"2042":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-11","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","content":"IVF-RaBitQ supports Linux and macOS on x86\\_64 / ARM64, Windows x86\\_64, Android arm64-v8a, and iOS ARM64. On x86\\_64, the CPU must support AVX2/FMA or AVX-512 (F/BW/DQ); Zvec selects the available implementation at runtime. ARM64 uses NEON.","locale":"en"},"2043":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-12","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-construction-️","content":"**Train IVF centroids**: The system generates `nlist` cluster centroids from the training data. `sample_count` can limit the number of training samples so very large datasets do not require every vector during training.","locale":"en"},"2044":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-13","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-construction-️","content":"**Assign inverted lists**: Each vector is assigned to its nearest centroid and stored in the corresponding inverted list.","locale":"en"},"2045":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-14","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-construction-️","content":"**Encode with RaBitQ**: The system applies a random rotation and quantizes each vector relative to its assigned centroid. Each dimension uses at least one binary bit. When `total_bits` is greater than `1`, the extra bits improve distance-estimation accuracy.","locale":"en"},"2046":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-15","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-construction-️","content":"**Arrange codes in batches**: Quantized codes in the same inverted list are stored in batches for parallel computation during queries.","locale":"en"},"2047":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-16","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-","content":"**Select inverted lists**: The system compares the query vector with all centroids and selects only the nearest `nprobe` inverted lists.","locale":"en"},"2048":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-17","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-","content":"**Preprocess the query**: The query vector undergoes the same rotation used during index construction, and the system creates the query state required for batch distance estimation.","locale":"en"},"2049":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-18","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-","content":"**Estimate distances in batches**: The system first uses the 1-bit codes to estimate candidate distances and error lower bounds, pruning candidates that cannot enter the Top-K. It then uses the extra quantization bits to improve estimates for the remaining candidates.","locale":"en"},"2050":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-19","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-","content":"**Optionally refine exact scores**: When `is_using_refiner` is enabled, the system expands the candidate set and recomputes scores using the original FP32 vectors.","locale":"en"},"2051":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-20","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#when-to-use-ivf-rabitq","content":"✅ The dataset is large and you need to reduce both the candidate scan scope and vector memory usage","locale":"en"},"2052":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-21","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#when-to-use-ivf-rabitq","content":"✅ The data has cluster structure that IVF can use to narrow the search space","locale":"en"},"2053":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-22","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#when-to-use-ivf-rabitq","content":"✅ You can accept offline clustering and tune `nlist` and `nprobe` for the desired recall and latency","locale":"en"},"2054":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-23","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#when-to-use-ivf-rabitq","content":"**Best practice**: Start with the default `total_bits=7` and primarily tune `nprobe` to balance recall and latency. Reduce `total_bits` only when index memory remains too high and some loss of accuracy is acceptable.","locale":"en"},"2055":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-24","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#when-to-use-ivf-rabitq","content":"With the same RaBitQ encoding, IVF-RaBitQ generally has less structural memory overhead than HNSW-RaBitQ, but it is more sensitive to clustering quality and query parameters. If low latency and high recall are the priority and graph memory is acceptable, consider HNSW-RaBitQ. If memory efficiency at large scale is the priority, evaluate IVF-RaBitQ first.","locale":"en"},"2056":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-25","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#advantages","content":"✨ **Reduces query work in two stages** — IVF scans only selected inverted lists, while RaBitQ uses compact codes and bitwise operations to accelerate distance estimation within each list","locale":"en"},"2057":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-26","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#advantages","content":"✨ **High memory efficiency** — With `total_bits=1`, the quantized vector payload alone can theoretically be about 1/32 the size of FP32; the actual index also contains centroids, document IDs, alignment, and other metadata","locale":"en"},"2058":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-27","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#advantages","content":"✨ **Error-bound pruning** — Low-cost estimates and lower bounds prune candidates first, and only candidates that may enter the Top-K receive more detailed computation","locale":"en"},"2059":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-28","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#trade-offs","content":"⚠️ **Higher construction cost** — Requires centroid training, random rotation, and quantized-code generation","locale":"en"},"2060":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-29","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#trade-offs","content":"⚠️ **Parameter sensitivity** — `nlist` and `nprobe` must be evaluated against the dataset size, distribution, recall target, and latency budget","locale":"en"},"2061":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-30","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#trade-offs","content":"⚠️ **Data constraints** — Supports FP32 dense vectors with 64–4095 dimensions and the `L2`, `IP`, and `COSINE` metrics","locale":"en"},"2062":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-31","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Parameter","locale":"en"},"2063":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-32","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Default","locale":"en"},"2064":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-33","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Description","locale":"en"},"2065":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-34","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Tuning Guidance","locale":"en"},"2066":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-35","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"`metric_type`","locale":"en"},"2067":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-36","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"`MetricType.IP`","locale":"en"},"2068":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-37","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Similarity metric used to compare vectors; supports `L2`, `IP`, and `COSINE`","locale":"en"},"2069":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-38","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Choose the metric that matches how the embedding model was trained","locale":"en"},"2070":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-39","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"`nlist`","locale":"en"},"2071":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-40","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"`1024`","locale":"en"},"2072":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-41","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"**Number of clusters (inverted lists)** — The number of partitions created during index construction","locale":"en"},"2073":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-42","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Start by evaluating `nlist` ≈ $\\sqrt{N}$, where `N` is the number of vectors. Higher values create smaller, more granular lists but increase training, centroid-comparison, and metadata costs. `nlist` must be greater than `0`, and the training set must contain enough samples to form the requested clusters","locale":"en"},"2074":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-43","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"`total_bits`","locale":"en"},"2075":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-44","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"`7`","locale":"en"},"2076":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-45","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"**Total RaBitQ bits per dimension** — Accepts values from `1` to `9`","locale":"en"},"2077":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-46","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Higher values generally improve distance-estimation accuracy and recall but consume more memory. `1` uses only the base binary code","locale":"en"},"2078":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-47","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"`sample_count`","locale":"en"},"2079":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-48","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"`0`","locale":"en"},"2080":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-49","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"**Training sample count** — `0` uses all vectors to train the cluster centroids","locale":"en"},"2081":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-50","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"For very large datasets, set a positive value below the total vector count to reduce training time and peak memory. The value cannot be negative","locale":"en"},"2082":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-51","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#index-time-parameters","content":"Node.js uses camelCase parameter names: `metricType`, `nList`, `totalBits`, and `sampleCount`.","locale":"en"},"2083":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-52","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Parameter","locale":"en"},"2084":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-53","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Default","locale":"en"},"2085":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-54","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Description","locale":"en"},"2086":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-55","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Tuning Guidance","locale":"en"},"2087":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-56","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`nprobe`","locale":"en"},"2088":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-57","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`10`","locale":"en"},"2089":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-58","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"**Number of inverted lists searched at query time** — The system scans the lists whose centroids are nearest to the query vector","locale":"en"},"2090":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-59","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Higher values generally improve recall but increase latency. Values above the actual number of lists are clamped to the number of available lists. The value must be greater than `0`","locale":"en"},"2091":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-60","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`radius`","locale":"en"},"2092":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-61","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`0.0`","locale":"en"},"2093":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-62","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"**Distance (similarity) threshold** used for range filtering","locale":"en"},"2094":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-63","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Returns only documents that satisfy the threshold. Avoid an overly strict threshold when a complete Top-K result set is required","locale":"en"},"2095":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-64","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`is_linear`","locale":"en"},"2096":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-65","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`False`","locale":"en"},"2097":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-66","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Forces brute-force linear search instead of using the IVF-RaBitQ index","locale":"en"},"2098":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-67","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Use only for debugging, small collections, or validating index results. It is expensive on large datasets","locale":"en"},"2099":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-68","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`is_using_refiner`","locale":"en"},"2100":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-69","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`False`","locale":"en"},"2101":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-70","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Recomputes exact scores for quantized-search candidates using the original FP32 vectors","locale":"en"},"2102":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-71","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Enable when higher accuracy is required. Candidate reads and exact distance computation increase latency","locale":"en"},"2103":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-72","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`scale_factor`","locale":"en"},"2104":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-73","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"`10.0`","locale":"en"},"2105":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-74","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Candidate expansion factor used when the Refiner is enabled","locale":"en"},"2106":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-75","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"Higher values provide more candidates for refinement and may improve recall, but increase latency. Applies only when `is_using_refiner=True`","locale":"en"},"2107":{"id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index-76","page_id":"/en/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/ivf-rabitq-index#query-time-parameters","content":"In Node.js, `nprobe` and `radius` keep the same names. The remaining parameters are `isLinear`, `isUsingRefiner`, and `scaleFactor`.","locale":"en"},"2108":{"id":"/en/docs/db/concepts/vector-index/quantization","page_id":"/en/docs/db/concepts/vector-index/quantization","type":"page","content":"Quantization","breadcrumbs":["Docs","Products","Zvec","Introduction","Concepts","Vector Index"],"tags":[],"url":"/en/docs/db/concepts/vector-index/quantization","locale":"en"},"2109":{"id":"/en/docs/db/concepts/vector-index/quantization-0","page_id":"/en/docs/db/concepts/vector-index/quantization","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/quantization#storage-behavior","content":"Storage Behavior","locale":"en"},"2110":{"id":"/en/docs/db/concepts/vector-index/quantization-1","page_id":"/en/docs/db/concepts/vector-index/quantization","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/quantization#enabling-quantization","content":"Enabling Quantization","locale":"en"},"2111":{"id":"/en/docs/db/concepts/vector-index/quantization-2","page_id":"/en/docs/db/concepts/vector-index/quantization","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/quantization#quantization-types","content":"Quantization Types","locale":"en"},"2112":{"id":"/en/docs/db/concepts/vector-index/quantization-3","page_id":"/en/docs/db/concepts/vector-index/quantization","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/quantization#fp16-half-precision-floating-point","content":"FP16 (Half-Precision Floating Point)","locale":"en"},"2113":{"id":"/en/docs/db/concepts/vector-index/quantization-4","page_id":"/en/docs/db/concepts/vector-index/quantization","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/quantization#int8-8-bit-integer-quantization","content":"INT8 (8-Bit Integer Quantization)","locale":"en"},"2114":{"id":"/en/docs/db/concepts/vector-index/quantization-5","page_id":"/en/docs/db/concepts/vector-index/quantization","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/quantization#int4-4-bit-integer-quantization","content":"INT4 (4-Bit Integer Quantization)","locale":"en"},"2115":{"id":"/en/docs/db/concepts/vector-index/quantization-6","page_id":"/en/docs/db/concepts/vector-index/quantization","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-index/quantization#enabling-rotation","content":"Enabling Rotation","locale":"en"},"2116":{"id":"/en/docs/db/concepts/vector-index/quantization-7","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization","content":"Quantization is a compression technique that &#x2A;**transforms vectors from their original (specifically FP32) format into a more compact representation***, reducing the size of vector indexes used for search.","locale":"en"},"2117":{"id":"/en/docs/db/concepts/vector-index/quantization-8","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization","content":"This transformation approximates vectors using fewer bits per dimension — enabling:","locale":"en"},"2118":{"id":"/en/docs/db/concepts/vector-index/quantization-9","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization","content":"✨ Lower **memory footprint** — especially when the index is memory-resident,","locale":"en"},"2119":{"id":"/en/docs/db/concepts/vector-index/quantization-10","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization","content":"✨ Faster I/O and lower query latency — due to reduced data movement and efficient integer/fp16 arithmetic,","locale":"en"},"2120":{"id":"/en/docs/db/concepts/vector-index/quantization-11","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization","content":"✨ Better scalability on resource-constrained hardware.","locale":"en"},"2121":{"id":"/en/docs/db/concepts/vector-index/quantization-12","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization","content":"**Important**:","locale":"en"},"2122":{"id":"/en/docs/db/concepts/vector-index/quantization-13","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization","content":"Quantization is a &#x2A;**lossy and irreversible*** compression method. It improves runtime efficiency **at the cost of potentially reduced recall accuracy**. Always validate its effect on your retrieval quality.","locale":"en"},"2123":{"id":"/en/docs/db/concepts/vector-index/quantization-14","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization","content":"Quantization only provides benefits when applied to vectors in a **FP32** format.","locale":"en"},"2124":{"id":"/en/docs/db/concepts/vector-index/quantization-15","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#storage-behavior","content":"To ensure data integrity and flexibility, **Zvec stores both the original vectors and their quantized versions**. This means:","locale":"en"},"2125":{"id":"/en/docs/db/concepts/vector-index/quantization-16","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#storage-behavior","content":"The **overall on-disk storage usage may increase** (due to storing two copies).","locale":"en"},"2126":{"id":"/en/docs/db/concepts/vector-index/quantization-17","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#storage-behavior","content":"However, **only the quantized vectors are loaded into memory for indexing and search**, significantly reducing the active index size.","locale":"en"},"2127":{"id":"/en/docs/db/concepts/vector-index/quantization-18","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#storage-behavior","content":"Users can always **retrieve the original, unaltered vectors** when needed.","locale":"en"},"2128":{"id":"/en/docs/db/concepts/vector-index/quantization-19","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#enabling-quantization","content":"You can enable quantization at the time of vector index creation by selecting your preferred quantization type — e.g., `FP16`, `INT8`, or `INT4` — &#x2A;*using the `quantize_type` parameter in your `VectorSchema`**.","locale":"en"},"2129":{"id":"/en/docs/db/concepts/vector-index/quantization-20","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#enabling-quantization","content":"Once set, Zvec automatically generates and manages the quantized representation alongside your original vectors.","locale":"en"},"2130":{"id":"/en/docs/db/concepts/vector-index/quantization-21","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#fp16-half-precision-floating-point","content":"Uses 16-bit floating-point numbers to reduce memory footprint and accelerate computation while maintaining high numerical precision. Ideal for applications requiring near-FP32 accuracy with improved efficiency. Requires conversion from FP32 source.","locale":"en"},"2131":{"id":"/en/docs/db/concepts/vector-index/quantization-22","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#int8-8-bit-integer-quantization","content":"Represents vectors using 8-bit integers, significantly reducing storage and memory bandwidth requirements. Offers a good trade-off between speed, size, and retrieval accuracy for many similarity search tasks. Requires conversion from FP32 source.","locale":"en"},"2132":{"id":"/en/docs/db/concepts/vector-index/quantization-23","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#int4-4-bit-integer-quantization","content":"Ultra-compact representation using only 4 bits per dimension. Maximizes storage density and inference speed, suitable for latency-sensitive or resource-constrained environments where noticeable accuracy loss is acceptable. Requires conversion from FP32 source.","locale":"en"},"2133":{"id":"/en/docs/db/concepts/vector-index/quantization-24","page_id":"/en/docs/db/concepts/vector-index/quantization","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-index/quantization#enabling-rotation","content":"When using `INT8` or `INT4` quantization, you can &#x2A;*set `enable_rotate=True` via the `quantizer_param` parameter in your `VectorSchema`** to enable rotation. This applies a random orthogonal rotation to vectors before quantization, making the distribution across dimensions more uniform, which reduces information loss during quantization and improves the recall of the quantized index.","locale":"en"},"2134":{"id":"/en/docs/db/data-operations/query/filter","page_id":"/en/docs/db/data-operations/query/filter","type":"page","content":"Conditional Filtering","breadcrumbs":["Docs","Products","Zvec","Guides","Data Operations","Query"],"tags":[],"url":"/en/docs/db/data-operations/query/filter","locale":"en"},"2135":{"id":"/en/docs/db/data-operations/query/filter-0","page_id":"/en/docs/db/data-operations/query/filter","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/filter#performance-considerations","content":"Performance Considerations","locale":"en"},"2136":{"id":"/en/docs/db/data-operations/query/filter-1","page_id":"/en/docs/db/data-operations/query/filter","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/filter#prerequisites","content":"Prerequisites","locale":"en"},"2137":{"id":"/en/docs/db/data-operations/query/filter-2","page_id":"/en/docs/db/data-operations/query/filter","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/filter#performing-conditional-filtering","content":"Performing Conditional Filtering","locale":"en"},"2138":{"id":"/en/docs/db/data-operations/query/filter-3","page_id":"/en/docs/db/data-operations/query/filter","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/filter#supported-filter-syntax","content":"Supported Filter Syntax","locale":"en"},"2139":{"id":"/en/docs/db/data-operations/query/filter-4","page_id":"/en/docs/db/data-operations/query/filter","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/filter#comparison-operators","content":"Comparison Operators","locale":"en"},"2140":{"id":"/en/docs/db/data-operations/query/filter-5","page_id":"/en/docs/db/data-operations/query/filter","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/filter#membership-operators","content":"Membership Operators","locale":"en"},"2141":{"id":"/en/docs/db/data-operations/query/filter-6","page_id":"/en/docs/db/data-operations/query/filter","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/filter#string-operators","content":"String Operators","locale":"en"},"2142":{"id":"/en/docs/db/data-operations/query/filter-7","page_id":"/en/docs/db/data-operations/query/filter","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/filter#logical-operators","content":"Logical Operators","locale":"en"},"2143":{"id":"/en/docs/db/data-operations/query/filter-8","page_id":"/en/docs/db/data-operations/query/filter","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/filter","content":"Conditional filtering lets you retrieve documents that match specific criteria based on their scalar fields — similar to a `WHERE` clause in SQL.","locale":"en"},"2144":{"id":"/en/docs/db/data-operations/query/filter-9","page_id":"/en/docs/db/data-operations/query/filter","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/filter#performance-considerations","content":"**Indexed scalar fields**: Can be efficiently searched.","locale":"en"},"2145":{"id":"/en/docs/db/data-operations/query/filter-10","page_id":"/en/docs/db/data-operations/query/filter","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/filter#performance-considerations","content":"**Unindexed scalar fields**: Can still be searched, but with significantly lower performance.","locale":"en"},"2146":{"id":"/en/docs/db/data-operations/query/filter-11","page_id":"/en/docs/db/data-operations/query/filter","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/filter#performance-considerations","content":"For optimal performance, ensure **frequently filtered fields are indexed**.\\\nFor more details, please see the Inverted Index.","locale":"en