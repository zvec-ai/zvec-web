":"en"},"2604":{"id":"/en/docs/db/data-operations/query-18","page_id":"/en/docs/db/data-operations/query","tags":[],"type":"text","url":"/en/docs/db/data-operations/query#query","content":"`param` (optional): Index-specific query parameters (e.g., `ef` for HNSW or `default_operator` for full-text search)","locale":"en"},"2605":{"id":"/en/docs/db/data-operations/query-19","page_id":"/en/docs/db/data-operations/query","tags":[],"type":"text","url":"/en/docs/db/data-operations/query#query","content":"Each `ZVecQuery` specifies:","locale":"en"},"2606":{"id":"/en/docs/db/data-operations/query-20","page_id":"/en/docs/db/data-operations/query","tags":[],"type":"text","url":"/en/docs/db/data-operations/query#query","content":"`fieldName`: The name of the vector or full-text field to search","locale":"en"},"2607":{"id":"/en/docs/db/data-operations/query-21","page_id":"/en/docs/db/data-operations/query","tags":[],"type":"text","url":"/en/docs/db/data-operations/query#query","content":"**Query source**:","locale":"en"},"2608":{"id":"/en/docs/db/data-operations/query-22","page_id":"/en/docs/db/data-operations/query","tags":[],"type":"text","url":"/en/docs/db/data-operations/query#query","content":"For vector search, provide `vector`","locale":"en"},"2609":{"id":"/en/docs/db/data-operations/query-23","page_id":"/en/docs/db/data-operations/query","tags":[],"type":"text","url":"/en/docs/db/data-operations/query#query","content":"For full-text search, provide `fts`","locale":"en"},"2610":{"id":"/en/docs/db/data-operations/query-24","page_id":"/en/docs/db/data-operations/query","tags":[],"type":"text","url":"/en/docs/db/data-operations/query#query","content":"`params` (optional): Index-specific query parameters (e.g., `ef` for HNSW or `defaultOperator` for full-text search)","locale":"en"},"2611":{"id":"/en/docs/db/data-operations/query-25","page_id":"/en/docs/db/data-operations/query","tags":[],"type":"text","url":"/en/docs/db/data-operations/query#query-types","content":"<Card tit