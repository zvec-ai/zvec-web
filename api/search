s/inspect#collection-schema","content":"To view **vector fields**:","locale":"en"},"1413":{"id":"/en/docs/db/collections/inspect-28","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-schema","content":"This will return an array of vector fields.","locale":"en"},"1414":{"id":"/en/docs/db/collections/inspect-29","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-statistics","content":"The `stats` property provides real-time operational insights:","locale":"en"},"1415":{"id":"/en/docs/db/collections/inspect-30","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-statistics","content":"`doc_count`: Total number of documents currently stored.","locale":"en"},"1416":{"id":"/en/docs/db/collections/inspect-31","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-statistics","content":"`index_completeness`: Fraction (0.0\\~1.0) indicating how much of the vector data has been indexed. A value of 1.0 means indexing is complete.","locale":"en"},"1417":{"id":"/en/docs/db/collections/inspect-32","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-options","content":"Runtime behavior is governed by the options used when opening the collection:","locale":"en"},"1418":{"id":"/en/docs/db/collections/inspect-33","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-options","content":"`enable_mmap: 1/true` → Memory-mapped I/O is enabled for faster access.","locale":"en"},"1419":{"id":"/en/docs/db/collections/inspect-34","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-options","content":"`read_only: 0/false` → The collection is open for both reads and writes.","locale":"en"},"1420":{"id":"/en/docs/db/collections/inspect-35","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-path","content":"The `path` property returns the on-disk location of the collection:","locale":"en"},"1421":{"id":"/en/docs/db/collections/inspect-36","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#collection-path","content":"This is the same path passed to `open()`.","locale":"en"},"1422":{"id":"/en/docs/db/collections/open","page_id":"/en/docs/db/collections/open","type":"page","content":"Open","breadcrumbs":["Docs","Products","Zvec","Guides","Collections"],"tags":[],"url":"/en/docs/db/collections/open","locale":"en"},"1423":{"id":"/en/docs/db/collections/open-0","page_id":"/en/docs/db/collections/open","type":"heading","tags":[],"url":"/en/docs/db/collections/open#usage","content":"Usage","locale":"en"},"1424":{"id":"/en/docs/db/collections/open-1","page_id":"/en/docs/db/collections/open","type":"heading","tags":[],"url":"/en/docs/db/collections/open#parameters","content":"Parameters","locale":"en"},"1425":{"id":"/en/docs/db/collections/open-2","page_id":"/en/docs/db/collections/open","tags":[],"type":"text","url":"/en/docs/db/collections/open","content":"To open an existing collection, use the `open()` function to load it from disk.","locale":"en"},"1426":{"id":"/en/docs/db/collections/open-3","page_id":"/en/docs/db/collections/open","tags":[],"type":"text","url":"/en/docs/db/collections/open","content":"The specified path **must point to an existing Zvec collection**. If no valid collection is found, `open()` will raise an error.","locale":"en"},"1427":{"id":"/en/docs/db/collections/open-4","page_id":"/en/docs/db/collections/open","tags":[],"type":"text","url":"/en/docs/db/collections/open#parameters","content":"`path`: The filesystem path to the collection directory.","locale":"en"},"1428":{"id":"/en/docs/db/collections/open-5","page_id":"/en/docs/db/collections/open","tags":[],"type":"text","url":"/en/docs/db/collections/open#parameters","content":"`option`: Settings that control runtime behavior.","locale":"en"},"1429":{"id":"/en/docs/db/collections/open-6","page_id":"/en/docs/db/collections/open","tags":[],"type":"text","url":"/en/docs/db/collections/open#parameters","content":"`read_only`: Opens the collection in read-only mode. Attempts to write will raise an error.","locale":"en"},"1430":{"id":"/en/docs/db/collections/open-7","page_id":"/en/docs/db/collections/open","tags":[],"type":"text","url":"/en/docs/db/collections/open#parameters","content":"Use read-only mode when sharing a collection across multiple processes — it ensures safe concurrent access without risking data corruption.","locale":"en"},"1431":{"id":"/en/docs/db/collections/open-8","page_id":"/en/docs/db/collections/open","tags":[],"type":"text","url":"/en/docs/db/collections/open#parameters","content":"`enable_mmap`: Uses memory-mapped I/O for faster access (defaults to `True`). This trades slightly higher memory cache usage for improved performance.","locale":"en"},"1432":{"id":"/en/docs/db/collections/optimize","page_id":"/en/docs/db/collections/optimize","type":"page","content":"Optimize","breadcrumbs":["Docs","Products","Zvec","Guides","Collections"],"tags":[],"url":"/en/docs/db/collections/optimize","locale":"en"},"1433":{"id":"/en/docs/db/collections/optimize-0","page_id":"/en/docs/db/collections/optimize","type":"heading","tags":[],"url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"Why Optimization is Needed","locale":"en"},"1434":{"id":"/en/docs/db/collections/optimize-1","page_id":"/en/docs/db/collections/optimize","type":"heading","tags":[],"url":"/en/docs/db/collections/optimize#usage-example","content":"Usage Example","locale":"en"},"1435":{"id":"/en/docs/db/collections/optimize-2","page_id":"/en/docs/db/collections/optimize","type":"heading","tags":[],"url":"/en/docs/db/collections/optimize#check-indexing-status","content":"Check Indexing Status","locale":"en"},"1436":{"id":"/en/docs/db/collections/optimize-3","page_id":"/en/docs/db/collections/optimize","type":"heading","tags":[],"url":"/en/docs/db/collections/optimize#when-to-call-optimize","content":"When to Call `optimize()`","locale":"en"},"1437":{"id":"/en/docs/db/collections/optimize-4","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize","content":"The `optimize()` method **improves search performance** by building the configured vector index from vectors accumulated in a temporary flat buffer. It runs **in the background** and **does not block reads or writes**, ensuring your application remains fully responsive.","locale":"en"},"1438":{"id":"/en/docs/db/collections/optimize-5","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"In Zvec, newly inserted vectors are **not added directly** to the configured vector index. Instead, they are first staged in a lightweight flat index (brute-force) buffer.","locale":"en"},"1439":{"id":"/en/docs/db/collections/optimize-6","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"This design choice offers important benefits — but also a trade-off:","locale":"en"},"1440":{"id":"/en/docs/db/collections/optimize-7","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"✅ **Strengths**","locale":"en"},"1441":{"id":"/en/docs/db/collections/optimize-8","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"**Maximum write throughput**: Enables high-speed data ingestion.","locale":"en"},"1442":{"id":"/en/docs/db/collections/optimize-9","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"**Streaming inserts**: Supports real-time insertion for index types like IVF that don't natively allow incremental updates.","locale":"en"},"1443":{"id":"/en/docs/db/collections/optimize-10","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"⚠️ **Trade-off**","locale":"en"},"1444":{"id":"/en/docs/db/collections/optimize-11","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"**Slower searches over time**: As the flat buffer grows, search performance degrades.","locale":"en"},"1445":{"id":"/en/docs/db/collections/optimize-12","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"🔁 **Solution**","locale":"en"},"1446":{"id":"/en/docs/db/collections/optimize-13","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"Call `optimize()` periodically. This triggers a background worker that merges the staged vectors into the configured vector index — **without interrupting ongoing reads or writes**. 🚀","locale":"en"},"1447":{"id":"/en/docs/db/collections/optimize-14","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#why-optimization-is-needed","content":"`optimize()` **does not lock the collection**. Other threads and operations can continue reading, writing, and querying without delay while optimization is running — your application stays fully responsive.","locale":"en"},"1448":{"id":"/en/docs/db/collections/optimize-15","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#check-indexing-status","content":"Use the `stats` property to get real-time insights into your collection's indexing state:","locale":"en"},"1449":{"id":"/en/docs/db/collections/optimize-16","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#check-indexing-status","content":"`doc_count`: Total number of documents currently stored.","locale":"en"},"1450":{"id":"/en/docs/db/collections/optimize-17","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#check-indexing-status","content":"`index_completeness`: Fraction (0.0\\~1.0) indicating how much of the vector data has been indexed.","locale":"en"},"1451":{"id":"/en/docs/db/collections/optimize-18","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#check-indexing-status","content":"`1.0` → All vectors for that vector field are fully indexed using the configured index","locale":"en"},"1452":{"id":"/en/docs/db/collections/optimize-19","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#check-indexing-status","content":"`0.0` → No indexing has occurred; all vectors remain in the flat buffer and are searched via brute force","locale":"en"},"1453":{"id":"/en/docs/db/collections/optimize-20","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#check-indexing-status","content":"**Values in between** → Indexing is partial or in progress","locale":"en"},"1454":{"id":"/en/docs/db/collections/optimize-21","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#when-to-call-optimize","content":"Optimize **regularly — but not too often**:","locale":"en"},"1455":{"id":"/en/docs/db/collections/optimize-22","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#when-to-call-optimize","content":"**Too infrequent** → Flat buffers grow large, degrading search performance","locale":"en"},"1456":{"id":"/en/docs/db/collections/optimize-23","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#when-to-call-optimize","content":"**Too frequent** → Wastes resources optimizing small batches prematurely","locale":"en"},"1457":{"id":"/en/docs/db/collections/optimize-24","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#when-to-call-optimize","content":"Find a balance based on your **data ingestion rate** and **query latency requirements**.","locale":"en"},"1458":{"id":"/en/docs/db/collections/optimize-25","page_id":"/en/docs/db/collections/optimize","tags":[],"type":"text","url":"/en/docs/db/collections/optimize#when-to-call-optimize","content":"**Best practice:**\\\nCheck your collection's indexing status if searches feel slow.\\\nAs a general guideline, consider optimizing when you have **100,000+ unindexed documents** — but adjust based on your specific use case.","locale":"en"},"1459":{"id":"/en/docs/db/collections/schema-evolution","page_id":"/en/docs/db/collections/schema-evolution","type":"page","content":"Schema Evolution","breadcrumbs":["Docs","Products","Zvec","Guides","Collections"],"tags":[],"url":"/en/docs/db/collections/schema-evolution","locale":"en"},"1460":{"id":"/en/docs/db/collections/schema-evolution-0","page_id":"/en/docs/db/collections/schema-evolution","type":"heading","tags":[],"url":"/en/docs/db/collections/schema-evolution#data-definition-language-ddl","content":"Data Definition Language (DDL)","locale":"en"},"1461":{"id":"/en/docs/db/collections/schema-evolution-1","page_id":"/en/docs/db/collections/schema-evolution","type":"heading","tags":[],"url":"/en/docs/db/collections/schema-evolution#prerequisites",