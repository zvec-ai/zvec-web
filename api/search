concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"`[2]`","locale":"en"},"1430":{"id":"/en/docs/db/concepts/inverted-index-71","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"Elena Gomez","locale":"en"},"1431":{"id":"/en/docs/db/concepts/inverted-index-72","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"`[3]`","locale":"en"},"1432":{"id":"/en/docs/db/concepts/inverted-index-73","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"Marco Rossi","locale":"en"},"1433":{"id":"/en/docs/db/concepts/inverted-index-74","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"`[4, 5]`","locale":"en"},"1434":{"id":"/en/docs/db/concepts/inverted-index-75","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"With these indexes in place, queries become extremely efficient ✨:","locale":"en"},"1435":{"id":"/en/docs/db/concepts/inverted-index-76","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"\"Find all Italian recipes\" → look up \"Italian\" in the `cuisine` index → `[1, 4, 5]`","locale":"en"},"1436":{"id":"/en/docs/db/concepts/inverted-index-77","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"\"Show recipes by Marco Rossi\" → look up \"Marco Rossi\" in the `author` index → `[4, 5]`","locale":"en"},"1437":{"id":"/en/docs/db/concepts/inverted-index-78","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"\"Find Italian recipes by Julia Chen\" → intersect `[1, 4, 5]` and `[1, 6]` → `[1]`","locale":"en"},"1438":{"id":"/en/docs/db/concepts/inverted-index-79","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#how-does-it-work","content":"We **do not index** `url`, because it's rarely used in queries. Indexing it would waste storage and slow down writes, with little benefit. Once we have a document ID, we can always fetch its `url` directly from the original data.","locale":"en"},"1439":{"id":"/en/docs/db/concepts/inverted-index-80","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#why-inverted","content":"Because it inverts the standard mapping:","locale":"en"},"1440":{"id":"/en/docs/db/concepts/inverted-index-81","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#why-inverted","content":"Direction","locale":"en"},"1441":{"id":"/en/docs/db/concepts/inverted-index-82","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#why-inverted","content":"Mapping","locale":"en"},"1442":{"id":"/en/docs/db/concepts/inverted-index-83","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#why-inverted","content":"Forward","locale":"en"},"1443":{"id":"/en/docs/db/concepts/inverted-index-84","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#why-inverted","content":"Document ID → List of Terms","locale":"en"},"1444":{"id":"/en/docs/db/concepts/inverted-index-85","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#why-inverted","content":"Inverted","locale":"en"},"1445":{"id":"/en/docs/db/concepts/inverted-index-86","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#why-inverted","content":"Term → List of Document IDs","locale":"en"},"1446":{"id":"/en/docs/db/concepts/inverted-index-87","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#why-inverted","content":"This inversion is what makes keyword-based search efficient. Instead of checking every document to see if it contains your query term, you jump straight to the term and get all matching documents immediately.","locale":"en"},"1447":{"id":"/en/docs/db/concepts/inverted-index-88","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#trade-offs","content":"While powerful, inverted indexes come with costs:","locale":"en"},"1448":{"id":"/en/docs/db/concepts/inverted-index-89","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#trade-offs","content":"⚠️ **Storage overhead**: The index requires additional storage space.","locale":"en"},"1449":{"id":"/en/docs/db/concepts/inverted-index-90","page_id":"/en/docs/db/concepts/inverted-index","tags":[],"type":"text","url":"/en/docs/db/concepts/inverted-index#trade-offs","content":"⚠️ **Write amplification**: Every write operation — `INSERT`, `UPSERT`, and `UPDATE` — require index maintenance, which adds latency to writes and increases I/O load.","locale":"en"},"1450":{"id":"/en/docs/db/concepts/vector-embedding","page_id":"/en/docs/db/concepts/vector-embedding","type":"page","content":"Vector Embedding","breadcrumbs":["Docs","Products","Zvec","Introduction","Concepts"],"tags":[],"url":"/en/docs/db/concepts/vector-embedding","locale":"en"},"1451":{"id":"/en/docs/db/concepts/vector-embedding-0","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding","content":"A numerical representation of unstructured data that captures semantic meaning for similarity search.","locale":"en"},"1452":{"id":"/en/docs/db/concepts/vector-embedding-1","page_id":"/en/docs/db/concepts/vector-embedding","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-embedding#what-is-a-vector","content":"What is a Vector?","locale":"en"},"1453":{"id":"/en/docs/db/concepts/vector-embedding-2","page_id":"/en/docs/db/concepts/vector-embedding","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-embedding#how-do-you-use-vectors-with-a-database","content":"How Do You Use Vectors with a Database?","locale":"en"},"1454":{"id":"/en/docs/db/concepts/vector-embedding-3","page_id":"/en/docs/db/concepts/vector-embedding","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-embedding#how-vectors-power-real-world-applications","content":"How Vectors Power Real-World Applications?","locale":"en"},"1455":{"id":"/en/docs/db/concepts/vector-embedding-4","page_id":"/en/docs/db/concepts/vector-embedding","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-embedding#what-is-an-embedding-model","content":"What is an Embedding Model?","locale":"en"},"1456":{"id":"/en/docs/db/concepts/vector-embedding-5","page_id":"/en/docs/db/concepts/vector-embedding","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-embedding#types-of-vectors","content":"Types of Vectors","locale":"en"},"1457":{"id":"/en/docs/db/concepts/vector-embedding-6","page_id":"/en/docs/db/concepts/vector-embedding","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-embedding#dense-vectors","content":"Dense Vectors","locale":"en"},"1458":{"id":"/en/docs/db/concepts/vector-embedding-7","page_id":"/en/docs/db/concepts/vector-embedding","type":"heading","tags":[],"url":"/en/docs/db/concepts/vector-embedding#sparse-vectors","content":"Sparse Vectors","locale":"en"},"1459":{"id":"/en/docs/db/concepts/vector-embedding-8","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#what-is-a-vector","content":"In the context of AI and vector databases, &#x2A;**a vector is a list of numbers generated by embedding models to capture the semantic essence of unstructured data*** —  such as text, images, or audio.","locale":"en"},"1460":{"id":"/en/docs/db/concepts/vector-embedding-9","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#what-is-a-vector","content":"These models transform raw input into a high-dimensional space where &#x2A;**semantically similar items produce similar vectors***, enabling AI systems to compare meaning rather than relying on exact word matches.","locale":"en"},"1461":{"id":"/en/docs/db/concepts/vector-embedding-10","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-do-you-use-vectors-with-a-database","content":"🗂️ **Store**: Generate embeddings from your data — documents, product images, or user profiles — and save them in the vector database.","locale":"en"},"1462":{"id":"/en/docs/db/concepts/vector-embedding-11","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-do-you-use-vectors-with-a-database","content":"🔍 **Search**: When a new query arrives (a question, photo, etc.), generate a **query vector** using the same embedding model, then ask the database to find the most similar vectors.","locale":"en"},"1463":{"id":"/en/docs/db/concepts/vector-embedding-12","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-do-you-use-vectors-with-a-database","content":"Using efficient indexes, the database quickly returns relevant results — even at large scale. This is the foundation of semantic search: **finding what &#x2A;**means**&#x2A; the same, not just what &#x2A;**says*** the same**.","locale":"en"},"1464":{"id":"/en/docs/db/concepts/vector-embedding-13","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-vectors-power-real-world-applications","content":"**Image search** is a great example:","locale":"en"},"1465":{"id":"/en/docs/db/concepts/vector-embedding-14","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-vectors-power-real-world-applications","content":"Each image is converted into a vector that captures its visual features — such as shape, color, and object type.","locale":"en"},"1466":{"id":"/en/docs/db/concepts/vector-embedding-15","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-vectors-power-real-world-applications","content":"Images that are **visually or semantically similar end up with nearby vectors**.","locale":"en"},"1467":{"id":"/en/docs/db/concepts/vector-embedding-16","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-vectors-power-real-world-applications","content":"By comparing these vectors, search systems can:","locale":"en"},"1468":{"id":"/en/docs/db/concepts/vector-embedding-17","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-vectors-power-real-world-applications","content":"✅ **Recognize the same person across different photos**: Even with changes in lighting, pose, or expression, images of one individual generate similar vectors, allowing the system to match identities reliably.","locale":"en"},"1469":{"id":"/en/docs/db/concepts/vector-embedding-18","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-vectors-power-real-world-applications","content":"✅ **Find look-alike products in e-commerce platforms**: When a user snaps a photo of a dress, lamp, or sofa, the system compares its vector to product vectors and retrieves items with similar appearance or style.","locale":"en"},"1470":{"id":"/en/docs/db/concepts/vector-embedding-19","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#how-vectors-power-real-world-applications","content":"All of this happens through fast vector similarity comparisons, powered by the vector database.","locale":"en"},"1471":{"id":"/en/docs/db/concepts/vector-embedding-20","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#what-is-an-embedding-model","content":"An embedding model is an AI model that converts raw data into vector embeddings — illustrated in the diagram at the top.","locale":"en"},"1472":{"id":"/en/docs/db/concepts/vector-embedding-21","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#what-is-an-embedding-model","content":"These models learn patterns from vast amounts of training data so that objects with similar meanings produce vectors that are close together in vector space — typically measured using distance metrics such as **cosine similarity**, **dot product**, or **Euclidean distance**.","locale":"en"},"1473":{"id":"/en/docs/db/concepts/vector-embedding-22","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#what-is-an-embedding-model","content":"**The choice of distance metric matters.** If an embedding model was trained for a specific metric (e.g., cosine similarity), the vector database should use the same metric during search to preserve semantic relationships and achieve optimal accuracy.","locale":"en"},"1474":{"id":"/en/docs/db/concepts/vector-embedding-23","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#what-is-an-embedding-model","content":"To explore and compare state-of-the-art embedding models, you can check out the Embedding Leaderboard on Hugging Face, which evaluates hundreds of models across diverse tasks and languages.","locale":"en"},"1475":{"id":"/en/docs/db/concepts/vector-embedding-24","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#types-of-vectors","content":"Vector representations are primarily categorized into two types: &#x2A;**dense**&#x2A; and &#x2A;**sparse***, each capturing data in its own way.","locale":"en"},"1476":{"id":"/en/docs/db/concepts/vector-embedding-25","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#dense-vectors","content":"Dense vectors are fixed-length, real-valued embeddings where (nearly) every dimension carries semantic information. These vectors are often generated by deep learning models that transform raw inputs (e.g., text, images, audio) into a structured vector space reflecting their semantic similarities.","locale":"en"},"1477":{"id":"/en/docs/db/concepts/vector-embedding-26","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#dense-vectors","content":"**✅ Semantic-Rich**: understands context and meaning (e.g., \"king – man + woman ≈ queen\")","locale":"en"},"1478":{"id":"/en/docs/db/concepts/vector-embedding-27","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#dense-vectors","content":"**⚠️ Opaque**: hard to interpret which features drive similarity","locale":"en"},"1479":{"id":"/en/docs/db/concepts/vector-embedding-28","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#sparse-vectors","content":"Sparse vectors are high-dimensional, often vocabulary-sized representations in which only a small subset of dimensions are non-zero. Each active dimension corresponds to a specific term (e.g., a word or n-gram), weighted by relevance scores such as **BM25**.","locale":"en"},"1480":{"id":"/en/docs/db/concepts/vector-embedding-29","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#sparse-vectors","content":"In this model, every document is converted into a vector — called a document vector — that records which terms appear in it and how important they are. Similarly, a search query is also turned into a sparse vector using the same weighting scheme.","locale":"en"},"1481":{"id":"/en/docs/db/concepts/vector-embedding-30","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#sparse-vectors","content":"Rather than relying on exact keyword matches, similarity between a query and a document is computed using the dot product of their vectors. This measures how well their weighted terms align: documents that contain the same important terms as the query receive higher scores — rewarding both **term overlap** and **term importance**.","locale":"en"},"1482":{"id":"/en/docs/db/concepts/vector-embedding-31","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#sparse-vectors","content":"For computational efficiency, sparse vectors use integer indices to map terms to their positions within a vocabulary dictionary rather than storing the term strings directly.","locale":"en"},"1483":{"id":"/en/docs/db/concepts/vector-embedding-32","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#sparse-vectors","content":"**✅ Interpretable**: non-zero dimensions map directly to known terms (e.g., `4017` → \"puppy\")","locale":"en"},"1484":{"id":"/en/docs/db/concepts/vector-embedding-33","page_id":"/en/docs/db/concepts/vector-embedding","tags":[],"type":"text","url":"/en/docs/db/concepts/vector-embedding#sparse-vectors","content":"**⚠️ Lacks Semantic Understanding**: treats \"car\" and \"automobile\" as unrelated unless explicitly linked","locale":"en"},"1485":{"id":"/en/docs/db/data-operations/delete","page_id":"/en/docs/db/data-operations/delete","type":"page","content":"Delete","breadcrumbs":["Docs","Products","Zvec","Guides","Data Operations"],"tags":[],"url":"/en/docs/db/data-operations/delete","locale":"en"},"1486":{"id":"/en/docs/db/data-operations/delete-0","page_id":"/en/docs/db/data-operations/delete","type":"heading","tags":[],"url":"/en/docs/db/data-operations/delete#delete-by-ids","content":"Delete by IDs","locale":"en"},"1487":{"id":"/en/docs/db/data-operations/delete-1","page_id":"/en/docs/db/data-operations/delete","type":"heading","tags":[],"url":"/en/docs/db/data-operations/delete#delete-by-filter-condition","content":"Delete by Filter Condition","locale":"en"},"1488":{"id":"/en/docs/db/data-operations/delete-2","page_id":"/en/docs/db/data-operations/delete","tags":[],"type":"text","url":"/en/docs/db/data-operations/delete","content":"Zvec provides two ways to delete documents. Choose the method that best fits your use case:","locale":"en"},"1489":{"id":"/en/docs/db/data-operations/delete-3","page_id":"/en/docs/db/data-operations/delete","tags":[],"type":"text","url":"/en/docs/db/data-operations/delete","content":"Method","locale":"en"},"1490":{"id":"/en/docs/db/data-operations/delete-4","page_id":"/en/docs/db/data-operations/delete","tags":[],"type":"text","url":"/en/docs/db/data-operations/delete","content":"Input","locale":"en"},"1491":{"id":"/en/docs/db/data-operations/delete-5","page_id":"/en/docs/db/data-operations/delete","tags":[],"type":"text","url":"/en/docs/db/data-operations/delete","content":"When to Use","locale":"en"},"1492":