l":"/zh/docs/db/collections/inspect#快速参考","content":"`Collection.stats`","locale":"zh"},"4100":{"id":"/zh/docs/db/collections/inspect-11","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#快速参考","content":"运行时指标，如 document 数量和索引构建进度","locale":"zh"},"4101":{"id":"/zh/docs/db/collections/inspect-12","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#快速参考","content":"`Collection.option`","locale":"zh"},"4102":{"id":"/zh/docs/db/collections/inspect-13","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#快速参考","content":"运行时配置 (如只读模式、内存映射)","locale":"zh"},"4103":{"id":"/zh/docs/db/collections/inspect-14","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#快速参考","content":"`Collection.path`","locale":"zh"},"4104":{"id":"/zh/docs/db/collections/inspect-15","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#快速参考","content":"Collection 目录的具体路径","locale":"zh"},"4105":{"id":"/zh/docs/db/collections/inspect-16","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#collection-schema","content":"查看 Schema：","locale":"zh"},"4106":{"id":"/zh/docs/db/collections/inspect-17","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#collection-schema","content":"`\"name\": \"my_collection\"`：collection 的名称。","locale":"zh"},"4107":{"id":"/zh/docs/db/collections/inspect-18","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#collection-schema","content":"**标量字段**：","locale":"zh"},"4108":{"id":"/zh/docs/db/collections/inspect-19","page_id":"/zh/docs/db/collections/inspect","tags":[],"type":"text","url":"/zh/docs/db/collections/inspect#collection-schema","conten