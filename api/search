":"en"},"1085":{"id":"/en/docs/db/collections/inspect-4","page_id":"/en/docs/db/collections/inspect","type":"heading","tags":[],"url":"/en/docs/db/collections/inspect#collection-path","content":"Collection Path","locale":"en"},"1086":{"id":"/en/docs/db/collections/inspect-5","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect","content":"Once you've opened a collection, you can inspect its structure, configuration, and runtime state to better understand how it's organized and performing. This is especially helpful during development, debugging, or system monitoring.","locale":"en"},"1087":{"id":"/en/docs/db/collections/inspect-6","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#quick-reference","content":"Property","locale":"en"},"1088":{"id":"/en/docs/db/collections/inspect-7","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#quick-reference","content":"Description","locale":"en"},"1089":{"id":"/en/docs/db/collections/inspect-8","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#quick-reference","content":"`Collection.schema`","locale":"en"},"1090":{"id":"/en/docs/db/collections/inspect-9","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#quick-reference","content":"Collection structure and field definitions (e.g., vector dimensions, data types)","locale":"en"},"1091":{"id":"/en/docs/db/collections/inspect-10","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#quick-reference","content":"`Collection.stats`","locale":"en"},"1092":{"id":"/en/docs/db/collections/inspect-11","page_id":"/en/docs/db/collections/inspect","tags":[],"type":"text","url":"/en/docs/db/collections/inspect#quick-reference","content":"Runtime metrics such as docum