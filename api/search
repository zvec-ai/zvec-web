ply universally regardless of the underlying index type","locale":"en"},"2646":{"id":"/en/docs/db/data-operations/query/single-vector-25","page_id":"/en/docs/db/data-operations/query/single-vector","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/single-vector#parameters","content":"**index-specific parameters**, which allow fine-tuning of search behavior based on the vector index in use","locale":"en"},"2647":{"id":"/en/docs/db/data-operations/query/single-vector-26","page_id":"/en/docs/db/data-operations/query/single-vector","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/single-vector#common-parameters","content":"Parameter","locale":"en"},"2648":{"id":"/en/docs/db/data-operations/query/single-vector-27","page_id":"/en/docs/db/data-operations/query/single-vector","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/single-vector#common-parameters","content":"Description","locale":"en"},"2649":{"id":"/en/docs/db/data-operations/query/single-vector-28","page_id":"/en/docs/db/data-operations/query/single-vector","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/single-vector#common-parameters","content":"`topk`","locale":"en"},"2650":{"id":"/en/docs/db/data-operations/query/single-vector-29","page_id":"/en/docs/db/data-operations/query/single-vector","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/single-vector#common-parameters","content":"The number of most similar documents to return.","locale":"en"},"2651":{"id":"/en/docs/db/data-operations/query/single-vector-30","page_id":"/en/docs/db/data-operations/query/single-vector","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/single-vector#common-parameters","content":"`include_vector`","locale":"en"},"2652":{"id":"/en/docs/db/data-operations/query/single-vector-31","page_id":"/en/docs/db/data-operations/query/single-vector","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/single-vector#common-parameters","con