epts/data-modeling#structure-of-a-document","content":"Structure of a Document","locale":"en"},"1051":{"id":"/en/docs/db/concepts/data-modeling-6","page_id":"/en/docs/db/concepts/data-modeling","type":"heading","tags":[],"url":"/en/docs/db/concepts/data-modeling#example-document","content":"Example Document","locale":"en"},"1052":{"id":"/en/docs/db/concepts/data-modeling-7","page_id":"/en/docs/db/concepts/data-modeling","type":"heading","tags":[],"url":"/en/docs/db/concepts/data-modeling#data-types","content":"Data Types","locale":"en"},"1053":{"id":"/en/docs/db/concepts/data-modeling-8","page_id":"/en/docs/db/concepts/data-modeling","type":"heading","tags":[],"url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"Scalar Types","locale":"en"},"1054":{"id":"/en/docs/db/concepts/data-modeling-9","page_id":"/en/docs/db/concepts/data-modeling","type":"heading","tags":[],"url":"/en/docs/db/concepts/data-modeling#vector-types","content":"Vector Types","locale":"en"},"1055":{"id":"/en/docs/db/concepts/data-modeling-10","page_id":"/en/docs/db/concepts/data-modeling","type":"heading","tags":[],"url":"/en/docs/db/concepts/data-modeling#indexes","content":"Indexes","locale":"en"},"1056":{"id":"/en/docs/db/concepts/data-modeling-11","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling","content":"In Zvec, data is organized into **collections** and **documents**.","locale":"en"},"1057":{"id":"/en/docs/db/concepts/data-modeling-12","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#collections","content":"A **collection** is a named container for documents — similar to a **table** in a relational database system such as MySQL, where each **document** represents a **row** in a table. A collection is where you store, organize, and query your data.","locale":"en"},"1058":{"id":"/en/docs/db/concepts/data-modeling-13","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#collections","content":"Every collection is governed by a **schema** that defines the scalar fields and vectors it contains, along with their types and indexing settings.","locale":"en"},"1059":{"id":"/en/docs/db/concepts/data-modeling-14","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#collections","content":"**All documents within a collection conform to the same schema**.","locale":"en"},"1060":{"id":"/en/docs/db/concepts/data-modeling-15","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#collections","content":"The collection schema in Zvec is **dynamic**: you can add or remove scalar fields and vectors at any time without recreating the collection.","locale":"en"},"1061":{"id":"/en/docs/db/concepts/data-modeling-16","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#collections","content":"**No cross-collection queries**: Joins, unions, or multi-collection searches are **not supported**. Design your data model accordingly.","locale":"en"},"1062":{"id":"/en/docs/db/concepts/data-modeling-17","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#why-use-collections","content":"Collections provide **isolation** by ensuring that each use case operates with its own dedicated schema and index configuration. This separation prevents interference between unrelated use cases and allows each to evolve independently.","locale":"en"},"1063":{"id":"/en/docs/db/concepts/data-modeling-18","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#why-use-collections","content":"For example:","locale":"en"},"1064":{"id":"/en/docs/db/concepts/data-modeling-19","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#why-use-collections","content":"A **Retrieval-Augmented Generation (RAG) collection** might store text embeddings together with metadata — such as title, section, source URL, and last-updated timestamp.","locale":"en"},"1065":{"id":"/en/docs/db/concepts/data-modeling-20","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#why-use-collections","content":"An **image search collection** could hold high-dimensional image embeddings along with associated fields like image ID, file path, or caption.","locale":"en"},"1066":{"id":"/en/docs/db/concepts/data-modeling-21","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#persistence","content":"**Each collection is persisted independently on disk in its own dedicated directory**, providing isolation between different use cases.","locale":"en"},"1067":{"id":"/en/docs/db/concepts/data-modeling-22","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#persistence","content":"Each collection is **self-contained within its directory**. This means you can relocate a collection's directory and Zvec will still be able to open it when provided with the correct path.","locale":"en"},"1068":{"id":"/en/docs/db/concepts/data-modeling-23","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#documents","content":"A document is the fundamental unit of data storage — think of it as a single record or row in a relational database table. Each document lives inside a collection and must conform to that collection's schema.","locale":"en"},"1069":{"id":"/en/docs/db/concepts/data-modeling-24","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#structure-of-a-document","content":"A document is a **structured** object composed of three core components.","locale":"en"},"1070":{"id":"/en/docs/db/concepts/data-modeling-25","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#structure-of-a-document","content":"🔑 `id`: A unique string identifier for the document, cannot be changed after insertion","locale":"en"},"1071":{"id":"/en/docs/db/concepts/data-modeling-26","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#structure-of-a-document","content":"📐 `vectors`: A named set of vectors","locale":"en"},"1072":{"id":"/en/docs/db/concepts/data-modeling-27","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#structure-of-a-document","content":"🗂️ `fields`: A named set of scalar (non-vector) fields, which can include strings, numbers, booleans, or arrays of these types","locale":"en"},"1073":{"id":"/en/docs/db/concepts/data-modeling-28","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#example-document","content":"This document belongs to a collection with a schema that defines:","locale":"en"},"1074":{"id":"/en/docs/db/concepts/data-modeling-29","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#example-document","content":"Two dense vector: `vector_1` (4-dimensional) and `vector_2` (6-dimensional)","locale":"en"},"1075":{"id":"/en/docs/db/concepts/data-modeling-30","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#example-document","content":"One sparse vector: `vector_3`","locale":"en"},"1076":{"id":"/en/docs/db/concepts/data-modeling-31","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#example-document","content":"Scalar fields: `category` (string), `price` (integer), and `languages` (array of strings)","locale":"en"},"1077":{"id":"/en/docs/db/concepts/data-modeling-32","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#example-document","content":"**All fields must conform to their declared types in the schema**. Vectors must exactly match the specified type (dense or sparse) and dimensionality (e.g., a 768-dimensional dense vector cannot accept a 512-dimensional vector).","locale":"en"},"1078":{"id":"/en/docs/db/concepts/data-modeling-33","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#example-document","content":"Once inserted, documents can be updated via `upsert()` or partial `update()` operations, but all modifications must still adhere to the collection's schema constraints.","locale":"en"},"1079":{"id":"/en/docs/db/concepts/data-modeling-34","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#data-types","content":"Zvec uses a strongly typed schema system based on the `DataType` enumeration. The supported types fall into two categories:","locale":"en"},"1080":{"id":"/en/docs/db/concepts/data-modeling-35","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#data-types","content":"**Scalar types** — strings, integers, floats, booleans, and arrays of these types","locale":"en"},"1081":{"id":"/en/docs/db/concepts/data-modeling-36","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#data-types","content":"**Vector types** — dense or sparse numeric representations for vector embeddings","locale":"en"},"1082":{"id":"/en/docs/db/concepts/data-modeling-37","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#data-types","content":"**Type safety is enforced at ingestion**: every field within a document must strictly conform to its declared `DataType`.","locale":"en"},"1083":{"id":"/en/docs/db/concepts/data-modeling-38","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"Elementary Types","locale":"en"},"1084":{"id":"/en/docs/db/concepts/data-modeling-39","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`STRING`","locale":"en"},"1085":{"id":"/en/docs/db/concepts/data-modeling-40","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`BOOL`","locale":"en"},"1086":{"id":"/en/docs/db/concepts/data-modeling-41","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`INT32`","locale":"en"},"1087":{"id":"/en/docs/db/concepts/data-modeling-42","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`INT64`","locale":"en"},"1088":{"id":"/en/docs/db/concepts/data-modeling-43","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`UINT32`","locale":"en"},"1089":{"id":"/en/docs/db/concepts/data-modeling-44","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`UINT64`","locale":"en"},"1090":{"id":"/en/docs/db/concepts/data-modeling-45","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`FLOAT`","locale":"en"},"1091":{"id":"/en/docs/db/concepts/data-modeling-46","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`DOUBLE`","locale":"en"},"1092":{"id":"/en/docs/db/concepts/data-modeling-47","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"Array Types","locale":"en"},"1093":{"id":"/en/docs/db/concepts/data-modeling-48","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`ARRAY_STRING`","locale":"en"},"1094":{"id":"/en/docs/db/concepts/data-modeling-49","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`ARRAY_BOOL`","locale":"en"},"1095":{"id":"/en/docs/db/concepts/data-modeling-50","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`ARRAY_INT32`","locale":"en"},"1096":{"id":"/en/docs/db/concepts/data-modeling-51","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`ARRAY_INT64`","locale":"en"},"1097":{"id":"/en/docs/db/concepts/data-modeling-52","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`ARRAY_UINT32`","locale":"en"},"1098":{"id":"/en/docs/db/concepts/data-modeling-53","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`ARRAY_UINT64`","locale":"en"},"1099":{"id":"/en/docs/db/concepts/data-modeling-54","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`ARRAY_FLOAT`","locale":"en"},"1100":{"id":"/en/docs/db/concepts/data-modeling-55","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"`ARRAY_DOUBLE`","locale":"en"},"1101":{"id":"/en/docs/db/concepts/data-modeling-56","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#scalar-types","content":"Arrays cannot contain mixed types or nested structures. All elements must match the declared array element type.","locale":"en"},"1102":{"id":"/en/docs/db/concepts/data-modeling-57","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#vector-types","content":"Dense Vector: represented as fixed-length numeric arrays, e.g., `[0.1, -0.5, ..., 0.9]`","locale":"en"},"1103":{"id":"/en/docs/db/concepts/data-modeling-58","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#vector-types","content":"`VECTOR_FP16`","locale":"en"},"1104":{"id":"/en/docs/db/concepts/data-modeling-59","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#vector-types","content":"`VECTOR_FP32`","locale":"en"},"1105":{"id":"/en/docs/db/concepts/data-modeling-60","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#vector-types","content":"`VECTOR_INT8`","locale":"en"},"1106":{"id":"/en/docs/db/concepts/data-modeling-61","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#vector-types","content":"Sparse Vector: represented as maps from integer indices to float values, e.g., `{ 42: 0.85, 1024: 0.13 }`","locale":"en"},"1107":{"id":"/en/docs/db/concepts/data-modeling-62","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#vector-types","content":"`SPARSE_VECTOR_FP32`","locale":"en"},"1108":{"id":"/en/docs/db/concepts/data-modeling-63","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#vector-types","content":"`SPARSE_VECTOR_FP16`","locale":"en"},"1109":{"id":"/en/docs/db/concepts/data-modeling-64","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#indexes","content":"Indexes accelerate data retrieval beyond basic storage of scalar fields and vectors. In Zvec:","locale":"en"},"1110":{"id":"/en/docs/db/concepts/data-modeling-65","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#indexes","content":"**Every vector field must be indexed** using an appropriate vector index to enable similarity search.","locale":"en"},"1111":{"id":"/en/docs/db/concepts/data-modeling-66","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#indexes","content":"**Scalar fields are optionally indexed** — but you should build inverted indexes on any scalar field you plan to use in filtering queries (e.g., `WHERE category = 'music'`).","locale":"en"},"1112":{"id":"/en/docs/db/concepts/data-modeling-67","page_id":"/en/docs/db/concepts/data-modeling","tags":[],"type":"text","url":"/en/docs/db/concepts/data-modeling#indexes","content":"You can define indexes at collection creation by specifying `index_param` in the schema for each field or vector.\\\nAlternatively, you can add indexes after collection creation by calling `create_index()` dynamically — no data re-ingestion required.","locale":"en"},"1113":{"id":"/en/docs/db/concepts/fts-index","page_id":"/en/docs/db/concepts/fts-index","type":"page","content":"Full-Text Index","breadcrumbs":["Docs","Products","Zvec","Introduction","Concepts"],"tags":[],"url":"/en/docs/db/concepts/fts-index","locale":"en"},"1114":{"id":"/en/docs/db/concepts/fts-index-0","page_id":"/en/docs/db/concepts/fts-index","tags":[],"type":"text","url":"/en/docs/db/concepts/fts-index","content":"An inverted-index-based text retrieval mechanism — supports natural language queries, phrase matching, and boolean expressions, ranked by BM25 relevance scoring.","locale":"en"},"1115":{"id":"/en/docs/db/concepts/fts-index-1","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#when-to-use-a-full-text-index","content":"When to Use a Full-Text Index","locale":"en"},"1116":{"id":"/en/docs/db/concepts/fts-index-2","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#how-does-it-work","content":"How Does It Work?","locale":"en"},"1117":{"id":"/en/docs/db/concepts/fts-index-3","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#1-tokenization","content":"Tokenization","locale":"en"},"1118":{"id":"/en/docs/db/concepts/fts-index-4","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#2-token-filtering","content":"Token Filtering","locale":"en"},"1119":{"id":"/en/docs/db/concepts/fts-index-5","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#3-building-the-inverted-map","content":"Building the Inverted Map","locale":"en"},"1120":{"id":"/en/docs/db/concepts/fts-index-6","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#4-bm25-scoring","content":"BM25 Scoring","locale":"en"},"1121":{"id":"/en/docs/db/concepts/fts-index-7","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#5-wand-optimization","content":"WAND Optimization","locale":"en"},"1122":{"id":"/en/docs/db/concepts/fts-index-8","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#tokenizers","content":"Tokenizers","locale":"en"},"1123":{"id":"/en/docs/db/concepts/fts-index-9","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#key-parameters","content":"Key Parameters","locale":"en"},"1124":{"id":"/en/docs/db/concepts/fts-index-10","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#index-time-parameters","content":"Index-Time Parameters","locale":"en"},"1125":{"id":"/en/docs/db/concepts/fts-index-11","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#query-time-parameters","content":"Query-Time Parameters","locale":"en"},"1126":{"id":"/en/docs/db/concepts/fts-index-12","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#full-text-index-vs-vector-index","content":"Full-Text Index vs. Vector Index","locale":"en"},"1127":{"id":"/en/docs/db/concepts/fts-index-13","page_id":"/en/docs/db/concepts/fts-index","type":"heading","tags":[],"url":"/en/docs/db/concepts/fts-index#trade-offs","content":"Trade-offs","locale":"en"},"1128":{"id":"/en/docs/db/concepts/fts-index-14","page_id":"/en/docs/db/concepts/fts-index","tags":[],"type":"text","url":"/en/docs/db/concepts/fts-index","content":"A full-text index is a data structure designed for &#x2A;**efficient keyword-based search over text content***.","locale":"en"},"1129":{"id":"/en/docs/db/concepts/fts-index-15","page_id":"/en/docs/db/concepts/fts-index","tags":[],"type":"text","url":"/en/docs/db/concepts/fts-index","content":"It breaks text fields into terms (tokens), builds an inverted mapping from terms to documents, and uses BM25 scoring to return results **ranked by relevance** — without scanning every document.","locale":"en"},"1130":{"id":"/en/docs/db/concepts/fts-index-16","page_id":"/en/docs/db/concepts/fts-index","tags":[],"type":"text","url":"/en/docs/db/concepts/fts-index#when-to-use-a-full-text-index","content":"Use a full-text index when you need to **search text content by keyword