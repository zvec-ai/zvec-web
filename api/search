le":"zh"},"4581":{"id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index-58","page_id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index#索引查询参数","content":"强制使用**暴力线性搜索**而非索引","locale":"zh"},"4582":{"id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index-59","page_id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index#索引查询参数","content":"🐌 大数据集下非常慢！ ✅ 仅用于：调试、小型 collection 或验证索引准确度","locale":"zh"},"4583":{"id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index-60","page_id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index#索引查询参数","content":"`is_using_refiner`","locale":"zh"},"4584":{"id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index-61","page_id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index#索引查询参数","content":"**启用精确分数精化** — 量化搜索后对候选结果重新计算精确 FP32 距离","locale":"zh"},"4585":{"id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index-62","page_id":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/hnsw-rabitq-index#索引查询参数","content":"✅ 开启：需要最高精度时  ⚠️ 因全精度重新评分会增加延迟","locale":"zh"},"4586":{"id":"/zh/docs/db/concepts/vector-index","page_id":"/zh/docs/db/concepts/vector-index","type":"page","content":"向量索引","breadcrumbs":["Docs","产品","Zvec","入门","概念","向量索引"],"tags":[],"url":"/zh/docs/db/concepts/vector-index","locale":"zh"},"4587":{"id":"/zh/docs/db/concepts/vector-index-0","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index","content":"用于加速相似度检索的专用数据结构 — 以极小的 Recall 损失换取速度和扩展性的质变。","locale":"zh"},"4588":{"id":"/zh/docs/db/concepts/vector-index-1","page_id":"/zh/docs/db/concepts/vector-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index#近似检索-vs-精确检索","content":"近似检索 vs. 精确检索","locale":"zh"},"4589":{"id":"/zh/docs/db/concepts/vector-index-2","page_id":"/zh/docs/db/concepts/vector-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index#recall衡量近似检索精度","content":"Recall：衡量近似检索精度","locale":"zh"},"4590":{"id":"/zh/docs/db/concepts/vector-index-3","page_id":"/zh/docs/db/concepts/vector-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"向量索引类型","locale":"zh"},"4591":{"id":"/zh/docs/db/concepts/vector-index-4","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index","content":"向量索引是一种专用数据结构，用于加速在大规模的向量 Embedding 数据上的相似度检索。","locale":"zh"},"4592":{"id":"/zh/docs/db/concepts/vector-index-5","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index","content":"在没有索引的情况下，若要检索出与查询向量最相似的的项，系统必须将其与数据库中的每一个向量进行比对 — 这种方式被称为**暴力检索**或 **Flat 检索**。","locale":"zh"},"4593":{"id":"/zh/docs/db/concepts/vector-index-6","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index","content":"暴力检索的特点：","locale":"zh"},"4594":{"id":"/zh/docs/db/concepts/vector-index-7","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index","content":"✅ **精确**：能够返回严格匹配的最相似结果，不存在近似计算。","locale":"zh"},"4595":{"id":"/zh/docs/db/concepts/vector-index-8","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index","content":"⚠️ **大规模下性能极低**：当面对数百万乃至数十亿的向量数据时，查询耗时可能长达数秒甚至数分钟，导致其无法满足实时应用的需求。","locale":"zh"},"4596":{"id":"/zh/docs/db/concepts/vector-index-9","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#近似检索-vs-精确检索","content":"大多数向量索引都采用了**近似最近邻** (ANN) 算法。","locale":"zh"},"4597":{"id":"/zh/docs/db/concepts/vector-index-10","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#近似检索-vs-精确检索","content":"ANN 不再执着于寻找绝对精确的“最相近匹配项”，而是转而寻找*高度准确的的近似结果*。在实际应用中，这些近似结果的质量往往与精确结果难分伯仲，但检索速度和效率却得到了质的提升。","locale":"zh"},"4598":{"id":"/zh/docs/db/concepts/vector-index-11","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#近似检索-vs-精确检索","content":"对于语义搜索或推荐系统这类实际应用场景而言，这种策略极具价值 — 因为它仅需牺牲很小的精度，就能换来速度和扩展性的质变。简而言之：&#x2A;**结果够准，速度够快*** ✨。","locale":"zh"},"4599":{"id":"/zh/docs/db/concepts/vector-index-12","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#recall衡量近似检索精度","content":"**Recall** 是评估 ANN 算法结果质量的标准指标。","locale":"zh"},"4600":{"id":"/zh/docs/db/concepts/vector-index-13","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#recall衡量近似检索精度","content":"它量化了这样一个比例：在近似方法返回的 Top‑k 结果中，有多少是真正包含在精确搜索(暴力检索)找到的“**真最近邻**”里的。","locale":"zh"},"4601":{"id":"/zh/docs/db/concepts/vector-index-14","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#recall衡量近似检索精度","content":"它量化的是**真实最近邻**（通过精确暴力搜索确定的）中，出现在近似方法返回的 top-k 结果中的比例：","locale":"zh"},"4602":{"id":"/zh/docs/db/concepts/vector-index-15","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#recall衡量近似检索精度","content":"示例：","locale":"zh"},"4603":{"id":"/zh/docs/db/concepts/vector-index-16","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#recall衡量近似检索精度","content":"如果你请求了 top 10 的结果，其中有 9 个与精确检索得出的的真实 top 10 匹配，则 `recall@10` 为 90%。","locale":"zh"},"4604":{"id":"/zh/docs/db/concepts/vector-index-17","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#recall衡量近似检索精度","content":"通常情况下，高 Recall（例如 ≥ 96%） 意味着对于大多数应用来说，这种近似搜索的效果与精确搜索在实际体验上几乎没有区别。","locale":"zh"},"4605":{"id":"/zh/docs/db/concepts/vector-index-18","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#recall衡量近似检索精度","content":"通过选用不同的索引类型 (如 HNSW) 及其参数 (如 `ef_search&#x60;)，你可以灵活权衡 &#x2A;**Recall、查询速度和资源开销***，从而针对特定的精度与性能需求进行优化。","locale":"zh"},"4606":{"id":"/zh/docs/db/concepts/vector-index-19","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"Zvec 支持以下向量索引类型，各自适用于不同的使用场景、数据集规模和性能需求：","locale":"zh"},"4607":{"id":"/zh/docs/db/concepts/vector-index-20","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"Flat（暴力检索）索引","locale":"zh"},"4608":{"id":"/zh/docs/db/concepts/vector-index-21","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"HNSW（分层可导航小世界）","locale":"zh"},"4609":{"id":"/zh/docs/db/concepts/vector-index-22","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"HNSW-RaBitQ（HNSW + RaBitQ 量化）","locale":"zh"},"4610":{"id":"/zh/docs/db/concepts/vector-index-23","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"DiskANN（基于磁盘的近似最近邻）","locale":"zh"},"4611":{"id":"/zh/docs/db/concepts/vector-index-24","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"IVF（倒排文件索引）","locale":"zh"},"4612":{"id":"/zh/docs/db/concepts/vector-index-25","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"IVF-RaBitQ（IVF + RaBitQ 量化）","locale":"zh"},"4613":{"id":"/zh/docs/db/concepts/vector-index-26","page_id":"/zh/docs/db/concepts/vector-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index#向量索引类型","content":"根据你的数据规模、延迟要求和精度容忍度选择索引类型。始终使用与你的 Embedding 模型训练时一致的距离度量。","locale":"zh"},"4614":{"id":"/zh/docs/db/concepts/vector-index/ivf-index","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"page","content":"IVF 索引","breadcrumbs":["Docs","产品","Zvec","入门","概念","向量索引"],"tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index","locale":"zh"},"4615":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-0","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index","content":"一种基于聚类、内存高效、适配海量规模的索引方法，尤其适合自带聚类结构的大规模数据集 — 代价是索引构建速度较慢，且调参更为复杂。","locale":"zh"},"4616":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-1","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#工作原理","content":"工作原理","locale":"zh"},"4617":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-2","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建阶段-️","content":"索引构建阶段 ⚙️","locale":"zh"},"4618":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-3","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#查询阶段-","content":"查询阶段 🔍","locale":"zh"},"4619":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-4","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#何时使用-ivf-索引","content":"何时使用 IVF 索引","locale":"zh"},"4620":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-5","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#优势","content":"优势","locale":"zh"},"4621":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-6","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#权衡","content":"权衡","locale":"zh"},"4622":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-7","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#关键参数","content":"关键参数","locale":"zh"},"4623":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-8","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"索引构建参数","locale":"zh"},"4624":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-9","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"索引查询参数","locale":"zh"},"4625":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-10","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#工作原理","content":"IVF 的核心原理是&#x2A;*将整个向量空间划分成若干个簇 (Cluster/聚类)**。其中，簇的数量由参数 `n_list` (即 number of lists)来控制。","locale":"zh"},"4626":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-11","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建阶段-️","content":"**聚类**：算法首先会执行聚类操作，生成 `n_list` 个簇。每个簇都由一个质心 (Centroid) 来代表，这个质心是一个中心点，能够最准确地代表该簇内所有的向量。","locale":"zh"},"4627":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-12","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建阶段-️","content":"**分配**：数据集中的每个向量都会被分配到离它**最近的那个质心所在的簇中**。随后，该向量会被存入与该质心关联的倒排列表 (也常被称为“桶”或 Bucket)。本质上，这个索引就构建成了一个从质心到其对应向量的映射关系。","locale":"zh"},"4628":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-13","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#查询阶段-","content":"**质心筛选**：查询阶段，系统先计算查询向量与所有 `n_list` 个质心的距离，从而找出距离最近的 `n_probe` 个质心 (`n_probe` 是一个控制要考察多少个质心的参数)。","locale":"zh"},"4629":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-14","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#查询阶段-","content":"**局部搜索**：系统将**搜索范围锁定在 `n_probe` 个选中的桶 (buckets) 内**，而非全量扫描整个 `N` 个向量的数据集。随后，系统仅在这些桶中执行暴力检索(或更精细的搜索)，从而找出最近邻向量。","locale":"zh"},"4630":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-15","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#何时使用-ivf-索引","content":"✅ 向量数据集具有天然的聚类或局部性结构","locale":"zh"},"4631":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-16","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#何时使用-ivf-索引","content":"✅ 处理超大规模数据集且内存效率至关重要","locale":"zh"},"4632":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-17","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#何时使用-ivf-索引","content":"✅ 需要通过精细调参获得最优性能","locale":"zh"},"4633":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-18","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#何时使用-ivf-索引","content":"**最佳实践**：","locale":"zh"},"4634":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-19","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#何时使用-ivf-索引","content":"IVF 索引在处理具有内在聚类结构的数据集时效果最佳。","locale":"zh"},"4635":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-20","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#何时使用-ivf-索引","content":"若需进一步提升内存效率并支持更大规模的数据，建议将其与乘积量化 (Product Quantization) 结合使用。","locale":"zh"},"4636":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-21","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#何时使用-ivf-索引","content":"IVF 索引的性能对 `n_list` 等参数高度敏感。因此，该索引最适合那些能够针对特定数据分布以及延迟和召回率做权衡，进行系统化实验、验证并优化参数的应用场景。","locale":"zh"},"4637":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-22","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#优势","content":"✨ **兼容性** — 常作为复合索引 (例如 IVF-PQ) 的基础层，用于进一步的优化","locale":"zh"},"4638":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-23","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#优势","content":"✨ **支撑海量数据** — 查询时间复杂度约为 &#x2A;*O(N / `n_list` × `n_probe`)**。当 `n_list` 较大且 `n_probe` 较小时，即使面对海量数据 (`N` 极大)，其查询效率依然非常高","locale":"zh"},"4639":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-24","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#优势","content":"✨ **内存高效** — 向量被存储在紧凑的倒排列表中，质心和列表指针带来的额外开销极小。与 HNSW 等基于图的索引方法相比，通常能显著节省内存","locale":"zh"},"4640":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-25","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#权衡","content":"⚠️ **索引构建开销大** — 建立索引需要经过聚类计算，计算密集度较高，构建速度通常比 HNSW 等索引更慢","locale":"zh"},"4641":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-26","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#权衡","content":"⚠️ **参数敏感** — 检索的召回率和延迟高度依赖于 `n_list` 和 `n_probe` 的选择","locale":"zh"},"4642":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-27","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"参数","locale":"zh"},"4643":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-28","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"描述","locale":"zh"},"4644":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-29","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"调参指南","locale":"zh"},"4645":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-30","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"`metric_type`","locale":"zh"},"4646":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-31","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"用于比较向量的**相似度度量**","locale":"zh"},"4647":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-32","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"根据 Embedding 模型的训练方式选择","locale":"zh"},"4648":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-33","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"`n_list`","locale":"zh"},"4649":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-34","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"**聚类数** (倒排列表数) — 在索引构建阶段，整个向量空间会被划分成这个数量的聚类","locale":"zh"},"4650":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-35","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"• 建议初始值 `n_list` ≈ $\\sqrt{N}$，其中 `N` 为向量数  • 调大 `n_list` → ✨ 分区更精细，每个桶更小，检索速度更快 — 但 ⚠️ 索引构建成本更高，且需要管理更多的质心  • 调小 `n_list` → ✨ 索引构建速度更快 — 但 ⚠️ 每个桶的体积更大，导致检索速度变慢","locale":"zh"},"4651":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-36","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"`n_iters`","locale":"zh"},"4652":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-37","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"**质心优化迭代次数** — 在索引构建阶段，用于优化聚类质心的迭代轮数","locale":"zh"},"4653":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-38","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"• 更多的 `n_iters` →  ✨ 聚类质量更好  ⚠️ 索引构建时间更长","locale":"zh"},"4654":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-39","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"`quantize_type`","locale":"zh"},"4655":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-40","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"向量**量化**方式  默认不开启量化","locale":"zh"},"4656":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-41","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引构建参数","content":"详见量化","locale":"zh"},"4657":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-42","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"参数","locale":"zh"},"4658":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-43","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"描述","locale":"zh"},"4659":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-44","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"调参指南","locale":"zh"},"4660":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-45","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"`n_probe`","locale":"zh"},"4661":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-46","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"**查询时搜索的聚类数量** — 系统仅从这些距离最近的聚类中检索候选向量","locale":"zh"},"4662":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-47","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"• 更大的 `n_probe` →  ✨ 召回率更高  ⚠️  查询速度更慢","locale":"zh"},"4663":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-48","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"`radius`","locale":"zh"},"4664":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-49","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"**距离(相似度)阈值**，用于范围过滤 — 只有满足该阈值的 documents 才会被返回","locale":"zh"},"4665":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-50","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"示例： • 使用内积 `MetricType.IP` 时，设置 `radius=0.6` 仅保留分数 > 0.6 的结果  ✅ 适用于：想要剔除掉低质量匹配的结果  🚫 不适用于：必须返回全部 top-K 个结果，不关心分数质量","locale":"zh"},"4666":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-51","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"`is_linear`","locale":"zh"},"4667":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-52","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"强制使用**暴力线性检索** (不使用配置的索引)","locale":"zh"},"4668":{"id":"/zh/docs/db/concepts/vector-index/ivf-index-53","page_id":"/zh/docs/db/concepts/vector-index/ivf-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-index#索引查询参数","content":"🐌 大数据集下非常慢！ ✅ 仅用于：调试、超小数据集或验证索引准确性","locale":"zh"},"4669":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"page","content":"IVF-RaBitQ 索引","breadcrumbs":["Docs","产品","Zvec","入门","概念","向量索引"],"tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","locale":"zh"},"4670":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-0","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","content":"将 IVF 的聚类分区与 RaBitQ 量化结合，在减少扫描范围的同时压缩向量数据，适合内存受限的大规模近似向量检索。","locale":"zh"},"4671":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-1","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#工作原理","content":"工作原理","locale":"zh"},"4672":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-2","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建阶段-️","content":"索引构建阶段 ⚙️","locale":"zh"},"4673":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-3","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#查询阶段-","content":"查询阶段 🔍","locale":"zh"},"4674":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-4","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#何时使用-ivf-rabitq","content":"何时使用 IVF-RaBitQ？","locale":"zh"},"4675":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-5","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#优势","content":"优势","locale":"zh"},"4676":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-6","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#权衡","content":"权衡","locale":"zh"},"4677":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-7","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#关键参数","content":"关键参数","locale":"zh"},"4678":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-8","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"索引构建参数","locale":"zh"},"4679":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-9","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","type":"heading","tags":[],"url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引查询参数","content":"索引查询参数","locale":"zh"},"4680":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-10","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","content":"IVF-RaBitQ 将 IVF 的聚类分区与 RaBitQ 量化结合起来：IVF 先缩小需要扫描的候选范围，RaBitQ 再以紧凑的二进制编码估算候选距离，从而同时降低查询计算量和索引内存占用。","locale":"zh"},"4681":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-11","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","content":"IVF-RaBitQ 支持 Linux x86\\_64 或 Windows x86\\_64，CPU 需支持 AVX2 或 AVX-512。Zvec 会自动选择最佳运行时。","locale":"zh"},"4682":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-12","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建阶段-️","content":"**训练 IVF 质心**：系统从训练数据中生成 `nlist` 个聚类质心。`sample_count` 可限制训练样本数，避免在超大数据集上使用全部向量训练。","locale":"zh"},"4683":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-13","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建阶段-️","content":"**分配倒排列表**：每个向量被分配到最近的质心，并写入该质心对应的倒排列表。","locale":"zh"},"4684":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-14","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建阶段-️","content":"**RaBitQ 编码**：系统对向量执行随机旋转，并围绕所属质心对向量进行量化。每个维度至少使用 1 位二进制编码；当 `total_bits` 大于 1 时，额外位用于提高距离估计精度。","locale":"zh"},"4685":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-15","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建阶段-️","content":"**按批次组织编码**：同一倒排列表内的量化编码按批次布局，以便查询时并行计算。","locale":"zh"},"4686":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-16","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#查询阶段-","content":"**选择倒排列表**：系统先比较查询向量与所有质心，仅选择距离最近的 `nprobe` 个倒排列表。","locale":"zh"},"4687":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-17","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#查询阶段-","content":"**预处理查询向量**：查询向量经过与建库阶段一致的旋转，并生成批量距离估计所需的查询状态。","locale":"zh"},"4688":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-18","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#查询阶段-","content":"**批量估算距离**：系统先使用 1 位编码快速估算候选距离和误差下界，淘汰不可能进入 Top-K 的候选；再对保留下来的候选使用额外量化位提高估算精度。","locale":"zh"},"4689":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-19","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#查询阶段-","content":"**可选精确精化**：启用 `is_using_refiner` 后，系统扩大候选集，并使用原始 FP32 向量重新计算分数。","locale":"zh"},"4690":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-20","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#何时使用-ivf-rabitq","content":"✅ 数据集规模很大，希望同时减少候选扫描量和向量内存占用","locale":"zh"},"4691":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-21","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#何时使用-ivf-rabitq","content":"✅ 数据具有一定的聚类结构，适合通过 IVF 缩小搜索范围","locale":"zh"},"4692":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-22","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#何时使用-ivf-rabitq","content":"✅ 可以接受离线聚类训练，并愿意针对 Recall 与延迟调节 `nlist` 和 `nprobe`","locale":"zh"},"4693":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-23","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#何时使用-ivf-rabitq","content":"✅ 运行环境为 Linux x86\\_64 或 Windows x86\\_64，CPU 需支持 AVX2 或 AVX-512","locale":"zh"},"4694":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-24","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#何时使用-ivf-rabitq","content":"**最佳实践**：先使用默认的 `total_bits=7`，主要通过 `nprobe` 调节查询时的 Recall 与延迟。只有在索引内存仍然过高且可以接受一定精度损失时，才降低 `total_bits`。","locale":"zh"},"4695":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-25","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#何时使用-ivf-rabitq","content":"对于相同的 RaBitQ 编码，IVF-RaBitQ 通常比 HNSW-RaBitQ 使用更少的结构性内存，但对聚类质量和查询参数更敏感。如果更关注低延迟和高 Recall，且可以承担图结构内存，可优先考虑 HNSW-RaBitQ；如果更关注大规模数据下的内存效率，可优先评估 IVF-RaBitQ。","locale":"zh"},"4696":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-26","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#优势","content":"✨ **双重缩减查询开销** — IVF 只扫描部分倒排列表，RaBitQ 再通过紧凑编码和位运算加速列表内距离估计","locale":"zh"},"4697":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-27","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#优势","content":"✨ **内存效率高** — `total_bits=1` 时，单看量化向量载荷，理论上可缩小到 FP32 的约 1/32；实际索引还包含质心、文档 ID、对齐及其他元数据","locale":"zh"},"4698":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-28","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#优势","content":"✨ **支持误差界剪枝** — 先使用低成本估算和下界过滤候选，仅对有机会进入 Top-K 的候选执行更精细的计算","locale":"zh"},"4699":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-29","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#权衡","content":"⚠️ **平台受限** — Linux x86\\_64 或 Windows x86\\_64，CPU 需支持 AVX2 或 AVX-512","locale":"zh"},"4700":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-30","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#权衡","content":"⚠️ **构建开销较大** — 需要训练质心、执行随机旋转并生成量化编码","locale":"zh"},"4701":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-31","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#权衡","content":"⚠️ **参数敏感** — `nlist` 和 `nprobe` 需要根据数据规模、分布、Recall 目标及延迟预算进行验证","locale":"zh"},"4702":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-32","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#权衡","content":"⚠️ **数据限制** — 仅支持 FP32 稠密向量、64–4095 维，以及 `L2`、`IP`、`COSINE` 距离度量","locale":"zh"},"4703":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-33","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"参数","locale":"zh"},"4704":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-34","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"默认值","locale":"zh"},"4705":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-35","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"描述","locale":"zh"},"4706":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-36","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"调参指南","locale":"zh"},"4707":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-37","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"`metric_type`","locale":"zh"},"4708":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-38","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"`MetricType.IP`","locale":"zh"},"4709":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-39","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"用于比较向量的相似度度量；支持 `L2`、`IP` 和 `COSINE`","locale":"zh"},"4710":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-40","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"根据 Embedding 模型的训练方式选择","locale":"zh"},"4711":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-41","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"`nlist`","locale":"zh"},"4712":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-42","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"`1024`","locale":"zh"},"4713":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-43","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"**聚类数（倒排列表数）** — 构建时将向量空间划分成的聚类数量","locale":"zh"},"4714":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-44","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"可从 `nlist` ≈ $\\sqrt{N}$ 开始实验，其中 `N` 为向量数。更大的值会形成更小、更细的列表，但增加训练、质心比较及元数据开销。`nlist` 必须大于 `0`，并应确保训练样本数足以形成所需聚类","locale":"zh"},"4715":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-45","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"`total_bits`","locale":"zh"},"4716":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-46","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"`7`","locale":"zh"},"4717":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-47","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"**RaBitQ 每维总量化位数** — 取值范围为 `1`–`9`","locale":"zh"},"4718":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-48","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"更大的值通常能提高距离估计精度和 Recall，但占用更多内存；`1` 表示仅使用基础二进制编码","locale":"zh"},"4719":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-49","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"`sample_count`","locale":"zh"},"4720":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-50","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"`0`","locale":"zh"},"4721":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-51","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"**训练样本数** — `0` 表示使用全部向量训练聚类质心","locale":"zh"},"4722":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-52","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"超大数据集可设置一个小于总向量数的正整数，以减少训练时间和峰值内存；不得小于 `0`","locale":"zh"},"4723":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-53","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引构建参数","content":"Node.js 使用 camelCase 参数名：`metricType`、`nList`、`totalBits` 和 `sampleCount`。","locale":"zh"},"4724":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-54","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引查询参数","content":"参数","locale":"zh"},"4725":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-55","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引查询参数","content":"默认值","locale":"zh"},"4726":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-56","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引查询参数","content":"描述","locale":"zh"},"4727":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-57","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引查询参数","content":"调参指南","locale":"zh"},"4728":{"id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index-58","page_id":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index","tags":[],"type":"text","url":"/zh/docs/db/concepts/vector-index/ivf-rabitq-index#索引查询参数","con