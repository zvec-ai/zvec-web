ations/query/fts#query-syntax-reference","content":"`(vector OR embedding) AND search`","locale":"en"},"2146":{"id":"/en/docs/db/data-operations/query/fts-76","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"`+(expr)`","locale":"en"},"2147":{"id":"/en/docs/db/data-operations/query/fts-77","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"Group must match","locale":"en"},"2148":{"id":"/en/docs/db/data-operations/query/fts-78","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"`+(vector OR embedding)`","locale":"en"},"2149":{"id":"/en/docs/db/data-operations/query/fts-79","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"`-(expr)`","locale":"en"},"2150":{"id":"/en/docs/db/data-operations/query/fts-80","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"Group must not match","locale":"en"},"2151":{"id":"/en/docs/db/data-operations/query/fts-81","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"`-(slow AND outdated)`","locale":"en"},"2152":{"id":"/en/docs/db/data-operations/query/fts-82","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"**Operator precedence**: `AND` / `NOT` bind tighter than `OR`. Adjacent terms without an explicit operator are combined using the `default_operator` setting (default: `OR`).","locale":"en"},"2153":{"id":"/en/docs/db/data-operations/query/fts-83","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"For complex queries mixing multiple operators, **use `()` to make grouping explicit** and avoid unexpected results.","locale":"en"},"2154":{"id":"/en/docs/db/data-operations/query/fts-84","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-syntax-reference","content":"Leading negation is not supported — both `NOT term` and standalone `-term` require at least one positive term. Use `a NOT b` or combine `-term` with positive terms (e.g., `a -b`).","locale":"en"},"2155":{"id":"/en/docs/db/data-operations/query/fts-85","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-parameters","content":"Parameter","locale":"en"},"2156":{"id":"/en/docs/db/data-operations/query/fts-86","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-parameters","content":"Description","locale":"en"},"2157":{"id":"/en/docs/db/data-operations/query/fts-87","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-parameters","content":"`topk`","locale":"en"},"2158":{"id":"/en/docs/db/data-operations/query/fts-88","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-parameters","content":"The number of top-scoring documents to return.","locale":"en"},"2159":{"id":"/en/docs/db/data-operations/query/fts-89","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-parameters","content":"`filter`","locale":"en"},"2160":{"id":"/en/docs/db/data-operations/query/fts-90","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-parameters","content":"An optional SQL-like boolean expression to restrict results. See conditional filtering for details.","locale":"en"},"2161":{"id":"/en/docs/db/data-operations/query/fts-91","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-parameters","content":"`output_fields`","locale":"en"},"2162":{"id":"/en/docs/db/data-operations/query/fts-92","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#query-parameters","content":"An optional list of scalar field names to include in results. If omitted, all scalar fields are returned.","locale":"en"},"2163":{"id":"/en/docs/db/data-operations/query/fts-93","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#default-operator","content":"By default, adjacent bare terms in both `match_string` and `query_string` are combined with `OR`. To change this to `AND`, pass a `FtsQueryParam` via the `param` field:","locale":"en"},"2164":{"id":"/en/docs/db/data-operations/query/fts-94","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#default-operator","content":"With `default_operator=\"AND\"`, this returns only documents containing **both** \"machine\" **and** \"learning\".","locale":"en"},"2165":{"id":"/en/docs/db/data-operations/query/fts-95","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#default-operator","content":"Explicit operators (`AND`, `OR`, `+`, `-`) in a `query_string` are not affected by `default_operator` — it only controls how adjacent bare terms are combined.","locale":"en"},"2166":{"id":"/en/docs/db/data-operations/query/fts-96","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#combining-fts-with-scalar-filters","content":"You can combine full-text search with scalar filters to narrow results:","locale":"en"},"2167":{"id":"/en/docs/db/data-operations/query/fts-97","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#combining-fts-with-scalar-filters","content":"FTS and vector search are **mutually exclusive within one query route**. A single `Query` / `ZVecQuery` should not set both `fts` and `vector` / `id`; use separate query routes with re-ranking, or run separate queries and merge results in your application.","locale":"en"},"2168":{"id":"/en/docs/db/data-operations/query/fts-98","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#tokenizers","content":"Zvec provides three built-in tokenizers. The tokenizer is configured per-field via `FtsIndexParam`.","locale":"en"},"2169":{"id":"/en/docs/db/data-operations/query/fts-99","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#tokenizers","content":"Tokenizer","locale":"en"},"2170":{"id":"/en/docs/db/data-operations/query/fts-100","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#tokenizers","content":"Name","locale":"en"},"2171":{"id":"/en/docs/db/data-operations/query/fts-101","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#tokenizers","content":"Description","locale":"en"},"2172":{"id":"/en/docs/db/data-operations/query/fts-102","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#tokenizers","content":"Standard","locale":"en"},"2173":{"id":"/en/docs/db/data-operations/query/fts-103","page_id":"/en/docs/db/data-operations/query/fts