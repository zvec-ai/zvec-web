183","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#constraints","content":"Leading negation (`NOT term` or standalone `-term`) is not supported — at least one positive term is required.","locale":"en"},"2447":{"id":"/en/docs/db/data-operations/query/group","page_id":"/en/docs/db/data-operations/query/group","type":"page","content":"Grouped Search","breadcrumbs":["Docs","Products","Zvec","Guides","Data Operations","Query"],"tags":[],"url":"/en/docs/db/data-operations/query/group","locale":"en"},"2448":{"id":"/en/docs/db/data-operations/query/group-0","page_id":"/en/docs/db/data-operations/query/group","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/group#how-it-works","content":"How It Works","locale":"en"},"2449":{"id":"/en/docs/db/data-operations/query/group-1","page_id":"/en/docs/db/data-operations/query/group","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/group#prerequisites","content":"Prerequisites","locale":"en"},"2450":{"id":"/en/docs/db/data-operations/query/group-2","page_id":"/en/docs/db/data-operations/query/group","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/group#performing-grouped-search","content":"Performing Grouped Search","locale":"en"},"2451":{"id":"/en/docs/db/data-operations/query/group-3","page_id":"/en/docs/db/data-operations/query/group","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/group#using-the-vector-from-an-existing-document","content":"Using the Vector from an Existing Document","locale":"en"},"2452":{"id":"/en/docs/db/data-operations/query/group-4","page_id":"/en/docs/db/data-operations/query/group","type":"heading","tags":[],"url":"/en/docs/db/data-operations/query/group#parameters","content":"Parameters","locale":"en"},"2453":{"id":"/en/docs/db/data-operations/query/group-5","page_id":"/en/docs/db/data-operations/query/group","type":"heading","tags":[],"url":"/en/docs/db/data