ocs/db/data-operations/upsert","tags":[],"type":"text","url":"/en/docs/db/data-operations/upsert#upsert-documents-with-multiple-fields-and-vectors","content":"`publish_year` (32-bit integer)","locale":"en"},"1679":{"id":"/en/docs/db/data-operations/upsert-38","page_id":"/en/docs/db/data-operations/upsert","tags":[],"type":"text","url":"/en/docs/db/data-operations/upsert#upsert-documents-with-multiple-fields-and-vectors","content":"**Vector embeddings**:","locale":"en"},"1680":{"id":"/en/docs/db/data-operations/upsert-39","page_id":"/en/docs/db/data-operations/upsert","tags":[],"type":"text","url":"/en/docs/db/data-operations/upsert#upsert-documents-with-multiple-fields-and-vectors","content":"`dense_embedding`: a 768-dimensional dense vector","locale":"en"},"1681":{"id":"/en/docs/db/data-operations/upsert-40","page_id":"/en/docs/db/data-operations/upsert","tags":[],"type":"text","url":"/en/docs/db/data-operations/upsert#upsert-documents-with-multiple-fields-and-vectors","content":"`sparse_embedding`: a sparse vector","locale":"en"},"1682":{"id":"/en/docs/db/data-operations/upsert-41","page_id":"/en/docs/db/data-operations/upsert","tags":[],"type":"text","url":"/en/docs/db/data-operations/upsert#upsert-documents-with-multiple-fields-and-vectors","content":"Upsert a document with multiple fields and vectors like this:","locale":"en"},"1683":{"id":"/en/docs/db/collections/create","page_id":"/en/docs/db/collections/create","type":"page","content":"Create","breadcrumbs":["Docs","Products","Zvec","Guides","Collections","Create"],"tags":[],"url":"/en/docs/db/collections/create","locale":"en"},"1684":{"id":"/en/docs/db/collections/create-0","page_id":"/en/docs/db/collections/create","type":"heading","tags":[],"url":"/en/docs/db/collections/create#create-and-open-a-collection","content":"Create and Open a Collection","locale":"en"},"1685":{"id":"/en/docs/db/collections/create-1","page_id":"/en/docs/db/collections/create","type":"heading","tags":[],"url":"/en/docs/db/collections/create#real-world-example--product-search","content":"Real-World Example: 🛒 Product Search","locale":"en"},"1686":{"id":"/en/docs/db/collections/create-2","page_id":"/en/docs/db/collections/create","type":"heading","tags":[],"url":"/en/docs/db/collections/create#️-scalar-fields-for-filtering--display","content":"🗂️ Scalar Fields: For Filtering & Display","locale":"en"},"1687":{"id":"/en/docs/db/collections/create-3","page_id":"/en/docs/db/collections/create","type":"heading","tags":[],"url":"/en/docs/db/collections/create#-vector-embeddings-for-semantic-relevance","content":"📐 Vector Embeddings: For Semantic Relevance","locale":"en"},"1688":{"id":"/en/docs/db/collections/create-4","page_id":"/en/docs/db/collections/create","tags":[],"type":"text","url":"/en/docs/db/collections/create#create-and-open-a-collection","content":"To create a new collection in Zvec, you need to define the following:","locale":"en"},"1689":{"id":"/en/docs/db/collections/create-5","page_id":"/en/docs/db/collections/create","tags":[],"type":"text","url":"/en/docs/db/collections/create#create-and-open-a-collection","content":"**Schema** —  the structural blueprint of your data, specifying scalar fields and vector embeddings.","locale":"en"},"1690":{"id":"/en/docs/db/collections/create-6","page_id":"/en/docs/db/collections/create","tags":[],"type":"text","url":"/en/docs/db/collections/create#create-and-open-a-collection","content":"**Collection options** (optional) — runtime settings that control how the collection behaves when opened (e.g., read-only mode).","locale":"en"},"1691":{"id":"/en/docs/db/collections/create-7","page_id":"/en/docs/db/collections/create","tags":[],"type":"text","url":"/en/docs/db/collections/create#create-and-open-a-collection","content":"Once defined, call `create_and_open()` to initialize a new collection at a specified path and return a `Collection` object ready for inserts and queries.","locale":"en"},"1692":{"id":"/en/docs/db/collections/create-8","page_id":"/