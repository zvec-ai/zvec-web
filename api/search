/fts#token-filters","content":"`\"lowercase\"`","locale":"en"},"2425":{"id":"/en/docs/db/data-operations/query/fts-162","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#token-filters","content":"Converts tokens to Unicode lowercase.","locale":"en"},"2426":{"id":"/en/docs/db/data-operations/query/fts-163","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#token-filters","content":"`\"ascii_folding\"`","locale":"en"},"2427":{"id":"/en/docs/db/data-operations/query/fts-164","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#token-filters","content":"Folds Unicode characters into ASCII equivalents.","locale":"en"},"2428":{"id":"/en/docs/db/data-operations/query/fts-165","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#token-filters","content":"`\"stemmer\"`","locale":"en"},"2429":{"id":"/en/docs/db/data-operations/query/fts-166","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#token-filters","content":"Normalizes word forms using a Snowball stemmer.","locale":"en"},"2430":{"id":"/en/docs/db/data-operations/query/fts-167","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#token-filters","content":"For English text, use `lowercase` and `stemmer` so case and word forms do not affect matching. For English-like text or text with diacritics, you can also add `ascii_folding` for accent-insensitive matching.","locale":"en"},"2431":{"id":"/en/docs/db/data-operations/query/fts-168","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#lowercase-filter","content":"`\"lowercase\"` converts tokens to Unicode lowercase.","locale":"en"},"2432":{"id":"/en/docs/db/data-operations/query/fts-169","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#ascii-folding-filter","content":"`\"ascii_folding\"` folds Unicode characters into ASCII equivalents.","locale":"en"},"2433":{"id":"/en/docs/db/data-operations/query/fts-170","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#stemmer-filter","content":"`\"stemmer\"` normalizes word forms using a Snowball stemmer. The default language is `\"english\"`.","locale":"en"},"2434":{"id":"/en/docs/db/data-operations/query/fts-171","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#stemmer-filter","content":"**Stemmer configuration** (via `extra_params` JSON):","locale":"en"},"2435":{"id":"/en/docs/db/data-operations/query/fts-172","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#stemmer-filter","content":"Key","locale":"en"},"2436":{"id":"/en/docs/db/data-operations/query/fts-173","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#stemmer-filter","content":"Type","locale":"en"},"2437":{"id":"/en/docs/db/data-operations/query/fts-174","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#stemmer-filter","content":"Default","locale":"en"},"2438":{"id":"/en/docs/db/data-operations/query/fts-175","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#stemmer-filter","content":"Description","locale":"en"},"2439":{"id":"/en/docs/db/data-operations/query/fts-176","page_id":"/en/docs/db/data-operations/query/fts","tags":[],"type":"text","url":"/en/docs/db/data-operations/query/fts#stemmer-fi